# monotonic milliseconds
#
# std.chrono.since measures against the wall clock, which can step; search
# deadlines need a clock that only moves forward.

use std.chrono.time;

pub fun now_ms() i64 {
    val c: time.InstantClock = time.instant();
    if (sel c.err) { ret 0; }
    ret c.ok.sec * 1000 + c.ok.nsec / 1000000;
}

test never_runs_backwards {
    val a:    i64 = now_ms();
    var spin: i64 = 0;
    var i:    i64 = 0;
    for (i < 2000000) {
        spin = spin + i;
        i    = i + 1;
    }
    val b: i64 = now_ms();
    if (b < a)     { ret 1; }
    if (spin == 0) { ret 2; }
    ret 0;
}
