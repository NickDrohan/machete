            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 64..71
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x80, 0x00, 0x00, 0x00 :: writes(xmm0)
