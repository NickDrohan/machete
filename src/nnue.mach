# a quantized perspective network, evaluated incrementally
#
#   768 inputs -> HIDDEN per perspective (one shared weight matrix) -> 1,
#   through one of BUCKETS output layers chosen by how many pieces are left
#
# a feature is (colour, piece kind, square), all three relative to whichever
# side is looking. seen from black the colours swap and the squares flip
# vertically, so "my pieces on my side of the board" always lands in the same
# inputs and the network never learns the board twice.
#
# the hidden layer is only ever updated, never recomputed: a move touches at
# most a handful of features, so make/unmake add and subtract columns instead
# of walking 32 pieces. position.mach owns that bookkeeping; this file owns
# the arithmetic.
#
# everything is integers. hidden values are on a scale where 1.0 is QA and
# output weights on one where 1.0 is QB, so the dot product lands on QA*QB and
# a single divide at the end turns it into centipawns. the float network that
# produced these numbers lives in harness/nnue, which is also the reference
# this implementation is checked against.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use std.simd.reduce.hsum_i32x4;
use std.simd.select.select_i16x8;
use std.simd.shuffle.splat_i16x8;
use std.simd.shuffle.splat_i32x4;

use machete.rng;

use fs:       std.filesystem;
use io_error: std.io.error;

pub val INPUTS: i64 = 768;
pub val HIDDEN: i64 = 256;

# output layers, one per band of piece counts: an opening and a rook ending
# want different things from the same hidden layer, and eight small output
# layers cost nothing but a lookup. The band is (pieces - 2) / 4, kings
# included, so 2-5 pieces use layer 0 and 30-32 use layer 7.
pub val BUCKETS: i64 = 8;

val QA:     i64 = 255; # a clipped-relu output of 1.0
val QB:     i64 = 64; # an output weight of 1.0
val HEADER: i64 = 32;

# how many centipawns a network output of 1.0 is worth. Unlike QA and QB this
# does not change the arithmetic, only the units the answer comes back in, so
# it is read from the file rather than fixed here: it is the one constant a
# retrained network is likely to want to move, and nothing else depends on it.
var SCALE: i64 = 400;

# aligned because output() and the accumulator read these 128 bits at a time.
# The alignment happens to hold without saying so; saying so keeps it true.
#[align(16)]
pub var FEATURE_WEIGHTS: [INPUTS * HIDDEN]i16;
#[align(16)]
pub var FEATURE_BIAS: [HIDDEN]i16;
#[align(16)]
pub var OUTPUT_WEIGHTS: [BUCKETS * 2 * HIDDEN]i16;
pub var OUTPUT_BIAS:    [BUCKETS]i32;

# whether a network file has been read; until it has, the engine uses the
# hand-written evaluation
pub var loaded: bool = false;

# the most features one move can change: castling moves a king and a rook, and
# each of those is a remove and a put. a capture is three (the captured piece,
# the mover leaving, the mover arriving) and a promotion with capture is also
# three, so four is the ceiling over every path through make().
val CHANGES: i64 = 4;

# one position's hidden layer, both perspectives. index 0 is white's view.
#
# `ready` is the whole point of the deferred scheme: a move records what it
# changed and returns, and `v` is only built when something actually asks for
# an evaluation. In a real search 64% of positions reached by make() are never
# evaluated - they are illegal, or late move pruning throws them away - and
# patching 512 int16 lanes for those was most of what the network cost.
#[align(16)]
pub rec Acc {
    v:      [2][HIDDEN]i16;
    ready:  i64;
    count:  i64;
    piece:  [CHANGES]u8;
    square: [CHANGES]i64;
    plus:   [CHANGES]i64;
}

# set when a move reports more changes than CHANGES allows, which the ceiling
# above says cannot happen. a test asserts it stays zero rather than trusting
# the argument.
pub var OVERFLOW: i64 = 0;

# a search never goes deeper than MAX_PLY, and quiescence is bounded by the
# same ceiling, so a stack twice that plus headroom cannot be run off the end.
# these are globals because a per-thread stack is 96 KB and helper threads
# keep everything large off their own stacks.
val SLOTS: i64 = 160;
# one stack per search thread, plus the main thread. smp.MAX_THREADS is 32;
# this file cannot import smp without a cycle, so the number is repeated here
# and the test below checks they still agree.
pub val STACK_COUNT: i64 = 33;
var     STACKS:      [STACK_COUNT][SLOTS]Acc;

# the accumulator stack belonging to one thread; 0 is the main thread
pub fun stack(id: i64) *Acc {
    ret ?STACKS[id][0];
}

# where (piece, square) lands in the 768 inputs, seen from one side
fun index(perspective: i64, pc: u8, sq: i64) i64 {
    var colour: i64 = (pc / 6)::i64;
    val kind:   i64 = (pc % 6)::i64;
    var square: i64 = sq;
    if (perspective == 1) {
        colour = colour ^ 1;
        square = square ^ 56;
    }
    ret (colour * 6 + kind) * 64 + square;
}

# 128 bits at a time: eight i16 lanes, which is what x86-64 gives us without
# reaching for AVX. writing the vector out as a literal would be eight scalar
# loads and seven inserts, so the pointer is reinterpreted instead and the
# whole register arrives in one move.
fun load8(p: *i16, at: i64) i16x8 {
    ret @((?p[at]):~*i16x8);
}

fun store8(p: *i16, at: i64, v: i16x8) {
    @((?p[at]):~*i16x8) = v;
}

# mark a slot as owing its contents to its parent plus the changes it records
pub fun defer(a: *Acc) {
    a.ready = 0;
    a.count = 0;
}

# record one feature change, or apply it now if this slot is already built
pub fun change(a: *Acc, pc: u8, sq: i64, plus: i64) {
    if (a.ready != 0) {
        if (plus != 0) { add(a, pc, sq); }
        or             { sub(a, pc, sq); }
        ret;
    }
    if (a.count >= CHANGES) {
        OVERFLOW = OVERFLOW + 1;
        ret;
    }
    a.piece[a.count]  = pc;
    a.square[a.count] = sq;
    a.plus[a.count]   = plus;
    a.count           = a.count + 1;
}

# build every slot from the deepest one that is already built up to `top`
pub fun materialise(accs: *Acc, top: i64) {
    var first: i64 = top;
    for (first > 0 && accs[first].ready == 0) { first = first - 1; }
    var at: i64 = first + 1;
    for (at <= top) {
        val a: *Acc = ?accs[at];
        carry(a, ?accs[at - 1]);
        var k: i64 = 0;
        for (k < a.count) {
            if (a.plus[k] != 0) { add(a, a.piece[k], a.square[k]); }
            or                  { sub(a, a.piece[k], a.square[k]); }
            k = k + 1;
        }
        a.ready = 1;
        at      = at + 1;
    }
}

# start from the bias, with no pieces on the board
pub fun reset(a: *Acc) {
    a.ready = 1;
    a.count = 0;
    var side: i64 = 0;
    for (side < 2) {
        var i: i64 = 0;
        for (i < HIDDEN) {
            a.v[side][i] = FEATURE_BIAS[i];
            i            = i + 1;
        }
        side = side + 1;
    }
}

pub fun add(a: *Acc, pc: u8, sq: i64) {
    var side: i64 = 0;
    for (side < 2) {
        val base: i64  = index(side, pc, sq) * HIDDEN;
        val into: *i16 = ?a.v[side][0];
        var i:    i64  = 0;
        for (i < HIDDEN) {
            store8(into, i, load8(into, i) + load8(?FEATURE_WEIGHTS[base], i));
            i = i + 8;
        }
        side = side + 1;
    }
}

pub fun sub(a: *Acc, pc: u8, sq: i64) {
    var side: i64 = 0;
    for (side < 2) {
        val base: i64  = index(side, pc, sq) * HIDDEN;
        val into: *i16 = ?a.v[side][0];
        var i:    i64  = 0;
        for (i < HIDDEN) {
            store8(into, i, load8(into, i) - load8(?FEATURE_WEIGHTS[base], i));
            i = i + 8;
        }
        side = side + 1;
    }
}

# a child position starts from its parent's hidden layer and is then patched
pub fun carry(child: *Acc, parent: *Acc) {
    var side: i64 = 0;
    for (side < 2) {
        val to:   *i16 = ?child.v[side][0];
        val from: *i16 = ?parent.v[side][0];
        var i:    i64  = 0;
        for (i < HIDDEN) {
            store8(to, i, load8(from, i));
            i = i + 8;
        }
        side = side + 1;
    }
}

# one perspective's contribution to the output
#
# A clipped hidden value is 0..QA and an output weight is -127..127, so every
# product fits an int16 exactly (255 * 127 = 32385); only the running sum needs
# to be wider.
#
# On x86-64 this is SSE2's pmaddwd, which multiplies eight int16 pairs and
# adds neighbouring products into four int32 lanes in one instruction - the
# multiply, the widening and half the adding at once, and exact. std.simd has
# no multiply-add, and the widening it does have cost two unpacks and two adds
# per eight lanes; with the two clamps as pmaxsw and pminsw, the output layer
# went from 11% of the search's time to (see the commit that made this). The
# assembler's mnemonic table has none of the three, so they are written as
# bytes, the way bitboard.mach writes popcnt; the registers are all ones the
# Windows x64 convention lets a function overwrite. Every other target keeps
# the portable loop below, and agree.py holds both to the numpy reference.
fun accumulate(values: *i16, weights: *i16, running: i32x4) i32x4 {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        var sums: [4]i32;
        val out:  *i32 = ?sums[0];
        asm x86_64 {
            mov rdx, {values}
            mov rcx, {weights}
            mov rax, {out}
            # xmm4 = 0, xmm3 = QA in every lane, xmm2 = the running sums
            .byte 0x66, 0x0F, 0xEF, 0xE4 :: writes(xmm4)
            .byte 0x66, 0x0F, 0x75, 0xDB :: writes(xmm3)
            .byte 0x66, 0x0F, 0x71, 0xD3, 0x08 :: writes(xmm3)
            .byte 0x66, 0x0F, 0xEF, 0xD2 :: writes(xmm2)
            # lanes 0..7
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x00, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0x00, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 8..15
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x10, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0x10, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 16..23
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x20, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0x20, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 24..31
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x30, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0x30, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 32..39
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x40, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0x40, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 40..47
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x50, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0x50, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 48..55
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x60, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0x60, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 56..63
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x70, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
