            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 72..79
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x90, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0x90, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 80..87
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0xA0, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
