            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 184..191
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x70, 0x01, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0x70, 0x01, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 192..199
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x80, 0x01, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0x80, 0x01, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 200..207
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0x90, 0x01, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0x90, 0x01, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 208..215
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0xA0, 0x01, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0xA0, 0x01, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 216..223
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0xB0, 0x01, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0xB0, 0x01, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 224..231
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0xC0, 0x01, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0xC0, 0x01, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 232..239
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0xD0, 0x01, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0xD0, 0x01, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 240..247
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0xE0, 0x01, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0xE0, 0x01, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 248..255
            .byte 0xF3, 0x0F, 0x6F, 0x82, 0xF0, 0x01, 0x00, 0x00 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xF3, 0x0F, 0x6F, 0x89, 0xF0, 0x01, 0x00, 0x00 :: writes(xmm1)
            .byte 0x66, 0x0F, 0xF5, 0xC1 :: writes(xmm0)
            .byte 0x66, 0x0F, 0xFE, 0xD0 :: writes(xmm2)
            # movdqu [rax], xmm2
            .byte 0xF3, 0x0F, 0x7F, 0x10 :: writes()
        }
        ret running + i32x4{sums[0], sums[1], sums[2], sums[3]};
    }
    $or {
        ret accumulate_portable(values, weights, running);
    }
}

# the same sum without pmaddwd: clamp, multiply in int16, widen, add
fun accumulate_portable(values: *i16, weights: *i16, running: i32x4) i32x4 {
    val zero: i16x8 = splat_i16x8(0);
    val high: i16x8 = splat_i16x8(QA::i16);
    var acc:  i32x4 = running;
    var i:    i64   = 0;
    for (i < HIDDEN) {
        var clipped: i16x8 = load8(values, i);
        clipped = select_i16x8(clipped < zero, zero, clipped);
        clipped = select_i16x8(high < clipped, high, clipped);
        val product: i16x8 = clipped * load8(weights, i);
        acc = acc + i32x4{product[0]::i32, product[1]::i32, product[2]::i32, product[3]::i32} + i32x4{product[4]::i32, product[5]::i32, product[6]::i32, product[7]::i32};
        i   = i + 8;
    }
    ret acc;
}

# which output layer a position with `pieces` pieces on the board uses
pub fun bucket(pieces: i64) i64 {
    var b: i64 = (pieces - 2) / 4;
    if (b < 0)           { b = 0; }
    if (b > BUCKETS - 1) { b = BUCKETS - 1; }
    ret b;
}

# centipawns from the side to move's point of view, with `pieces` pieces on
# the board
#
# the side to move's half of the hidden layer is read first, so the network
# can learn that having the move is worth something.
pub fun output(a: *Acc, side: u8, pieces: i64) i64 {
    val us:   i64   = side::i64;
    val b:    i64   = bucket(pieces);
    val base: i64   = b * 2 * HIDDEN;
    var acc:  i32x4 = splat_i32x4(0);
    acc = accumulate(?a.v[us][0], ?OUTPUT_WEIGHTS[base], acc);
    acc = accumulate(?a.v[us ^ 1][0], ?OUTPUT_WEIGHTS[base + HIDDEN], acc);
    val total: i64 = hsum_i32x4(acc)::i64;
    ret (total + OUTPUT_BIAS[b]::i64) * SCALE / (QA * QB);
}

fun u32_at(buf: *u8, at: i64) i64 {
    ret (@((?buf[at]):~*u32))::i64;
}

fun read_exact(f: fs.File, buf: *u8, len: i64) bool {
    var at: i64 = 0;
    for (at < len) {
        val got: res[usize, io_error.Error] = fs.read(f, ?buf[at], (len - at)::usize);
        if (sel got.err)      { ret false; }
        if (got.ok::i64 == 0) { ret false; }
        at = at + got.ok::i64;
    }
    ret true;
}

fun read_body(f: fs.File) bool {
    var head: [32]u8;
    if (!read_exact(f, ?head[0], HEADER)) { ret false; }

    val magic: str = "MCHNNUE2";
    var i:     i64 = 0;
    for (i < 8) {
        if (head[i] != magic[i]) { ret false; }
        i = i + 1;
    }
    # a file built for different dimensions or scales would evaluate to
    # plausible nonsense, so refuse it rather than load it
    if (u32_at(?head[0], 8) != INPUTS)  { ret false; }
    if (u32_at(?head[0], 12) != HIDDEN) { ret false; }
    if (u32_at(?head[0], 16) != QA)     { ret false; }
    if (u32_at(?head[0], 20) != QB)     { ret false; }
    val scale: i64 = u32_at(?head[0], 24);
    if (scale < 1 || scale > 4000)       { ret false; }
    if (u32_at(?head[0], 28) != BUCKETS) { ret false; }
    SCALE = scale;

    if (!read_exact(f, (?FEATURE_WEIGHTS[0]):~*u8, INPUTS * HIDDEN * 2))     { ret false; }
    if (!read_exact(f, (?FEATURE_BIAS[0]):~*u8, HIDDEN * 2))                 { ret false; }
    if (!read_exact(f, (?OUTPUT_WEIGHTS[0]):~*u8, BUCKETS * 2 * HIDDEN * 2)) { ret false; }
    if (!read_exact(f, (?OUTPUT_BIAS[0]):~*u8, BUCKETS * 4))                 { ret false; }

    ret true;
}

# read a network file; false leaves the engine on its hand-written evaluation
pub fun load(path: str) bool {
    loaded = false;
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret false; }
    var f:    fs.File             = opened.ok;
    val ok:   bool                = read_body(f);
    val shut: err[io_error.Error] = fs.close(?f);
    loaded = ok;
    ret ok;
}

var TEST_VALUES:  [HIDDEN]i16;
var TEST_WEIGHTS: [HIDDEN]i16;

test "nnue: the pmaddwd kernel sums exactly what the portable loop does" {
    # hidden values well outside 0..QA, so both clamps are exercised, and
    # weights across the whole range the quantizer allows. The kernel is
    # unrolled for HIDDEN = 256: a wider build fails here, not in a game.
    var r:     rng.Rng = rng.seeded(0x9E3779B97F4A7C15);
    var trial: i64     = 0;
    for (trial < 300) {
        var i: i64 = 0;
        for (i < HIDDEN) {
            TEST_VALUES[i]  = (rng.below(?r, 4001)::i64 - 2000)::i16;
            TEST_WEIGHTS[i] = (rng.below(?r, 255)::i64 - 127)::i16;
            i               = i + 1;
        }
        # the extremes on some trials: every lane at its largest product
        if (trial % 50 == 0) {
            i = 0;
            for (i < HIDDEN) {
                TEST_VALUES[i]  = 32767;
                TEST_WEIGHTS[i] = 127 - 254 * (trial / 50 % 2)::i16;
                i               = i + 1;
            }
        }
        val start: i32x4 = i32x4{trial::i32, 0 - 7, 11, 0};
        val fast:  i64   = hsum_i32x4(accumulate(?TEST_VALUES[0], ?TEST_WEIGHTS[0], start))::i64;
        val slow:  i64   = hsum_i32x4(accumulate_portable(?TEST_VALUES[0], ?TEST_WEIGHTS[0], start))::i64;
        if (fast != slow) { ret 1; }
        trial = trial + 1;
    }
    ret 0;
}
