# transposition table, sized by the UCI Hash option
#
# The table is the engine's memory of every position it has searched, and it
# is kept from move to move: after a move, the subtree under it is already
# stored, and the next search walks back through it on table hits. Its size
# is how much of that survives. Fixed at 128 MB until 0.5.2, it overflowed on
# most of the bot's moves (8 threads search 15-30 million positions a move
# into 8 million slots); one thread, two moves on, found 78% of the work saved
# after a depth-16 search and 48% after depth 18. It is now allocated from the
# operating system's pages, 128 MB until Hash asks for another size, and
# resized only between searches.
#
# Slots come in buckets of four, one 64-byte cache line, and a position may
# live in any slot of its bucket. A store that finds no slot of its own
# replaces the one worth least: the shallowest, counting an entry from an
# earlier search as four plies shallower per search since. With one slot per
# position, every quiescence store (depth 0) evicted whatever deep entry
# shared its slot, and entries from moves long past were never cleared out.
#
# a stored mate score counts from the root, so it must be converted to and
# from "distance from this node" as it crosses the table; search does that.

use std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;

use mv: machete.move;
use machete.move.Move;

# what the stored score means
pub val EXACT: u8 = 0;
# the score is a lower bound: the search failed high
pub val LOWER: u8 = 1;
# the score is an upper bound: no move beat alpha
pub val UPPER: u8 = 2;

# the size a table starts at, and the most Hash may ask for
pub val DEFAULT_MEGABYTES: i64 = 128;
pub val MAX_MEGABYTES:     i64 = 32768;

# the table's slots and the megabytes they take (set by resize), and its
# buckets of WAYS slots
pub var ENTRIES:   i64 = 0;
pub var MEGABYTES: i64 = 0;
val     WAYS:      i64 = 4;
var     BUCKETS:   i64 = 0;

pub rec Entry {
    key:   u64;
    move:  Move;
    score: i64;
    depth: i64;
    flag:  u8;
}

# A slot holds two words: everything but the key packed into one, and the key
# xor that word. A reader recovers the key by xoring them back, so an entry
# half-written by another thread fails to match and is simply ignored. This is
# the standard lockless-hashing trick, and it is what lets several threads
# share the table with no atomics on the common path.
rec Slot {
    guard: u64;
    data:  u64;
}

var TABLE: *Slot = nil;

# the operating system's pages, which come zeroed: a new table is empty
var PAGES:       allocator.Allocator;
var PAGES_READY: bool = false;

# give the table `megabytes`, rounded down to a power of two; when that much
# cannot be had, the largest smaller power of two that can. Returns the
# megabytes it now has, 0 when not even one could be had (and then there is
# no table: probe and store must not be called). Never called while a search
# runs; a new table is empty.
pub fun resize(megabytes: i64) i64 {
    if (!PAGES_READY) {
        val made: err[allocator.Error] = page.make(?PAGES);
        if (sel made.err) { ret 0; }
        PAGES_READY = true;
    }
    var want: i64 = megabytes;
    if (want < 1)             { want = 1; }
    if (want > MAX_MEGABYTES) { want = MAX_MEGABYTES; }
    var size: i64 = 1;
    for (size * 2 <= want) { size = size * 2; }
    if (size == MEGABYTES && TABLE != nil) {
        clear();
        ret size;
    }
    # the old table goes first: holding both at once is twice the memory
    if (TABLE != nil) {
        val freed: err[allocator.Error] = allocator.deallocate[Slot](?PAGES, TABLE, ENTRIES::usize);
        TABLE     = nil;
        ENTRIES   = 0;
        MEGABYTES = 0;
    }
    for (size >= 1) {
        val slots: i64                         = size * 1048576 / 16;
        val got:   res[*Slot, allocator.Error] = allocator.zallocate[Slot](?PAGES, slots::usize);
        if (sel got.err) {
            size = size / 2;
            cnt;
        }
        TABLE      = got.ok;
        ENTRIES    = slots;
        BUCKETS    = slots / WAYS;
        MEGABYTES  = size;
        GENERATION = 0;
        ret size;
    }
    ret 0;
}

# which search wrote an entry, counted modulo 64; new_search moves it on
var GENERATION: u64 = 0;

# a new search from the UCI thread: entries written before it start to age
pub fun new_search() {
    GENERATION = (GENERATION + 1) & 63;
}

# move in the low 32 bits, then score (16, biased), depth (8), flag (2) and
# the generation that wrote it (6)
fun pack(move: Move, score: i64, depth: i64, flag: u8) u64 {
    val biased: u64 = (score + 32768)::u64 & 0xFFFF;
    ret move::u64 | (biased << 32) | ((depth::u64 & 0xFF) << 48) | ((flag::u64 & 3) << 56) | (GENERATION << 58);
}

fun unpack(data: u64, out: *Entry) {
    out.move  = (data & 0xFFFFFFFF)::u32;
    out.score = ((data >> 32) & 0xFFFF)::i64 - 32768;
    out.depth = ((data >> 48) & 0xFF)::i64;
    out.flag  = ((data >> 56) & 3)::u8;
}

# how much an entry is worth keeping: its depth, less four per search since
# it was written; an empty slot is worth nothing at all
fun worth(e: *Slot) i64 {
    val data: u64 = e.data;
    if (data == 0 && e.guard == 0) { ret 0 - 1000; }
    val age: i64 = ((GENERATION - (data >> 58)) & 63)::i64;
    ret ((data >> 48) & 0xFF)::i64 - 4 * age;
}

# a table to search with: the default size the first time a search asks
pub fun ready() {
    if (TABLE == nil) { resize(DEFAULT_MEGABYTES); }
}

pub fun clear() {
    if (TABLE == nil) {
        resize(DEFAULT_MEGABYTES);
        ret;
    }
    var i: i64 = 0;
    for (i < ENTRIES) {
        TABLE[i].guard = 0;
        TABLE[i].data  = 0;
        i              = i + 1;
    }
    GENERATION = 0;
}

# the first slot of the bucket a key belongs to
fun bucket(key: u64) i64 {
    ret (key & (BUCKETS - 1)::u64)::i64 * WAYS;
}

# copy the entry for key into out; false when this position is not stored, or
# when its slot was caught mid-write by another thread
pub fun probe(key: u64, out: *Entry) bool {
    val first: i64 = bucket(key);
    var way:   i64 = 0;
    for (way < WAYS) {
        val e:    *Slot = ?TABLE[first + way];
        val data: u64   = e.data;
        if ((e.guard ^ data) == key) {
            out.key = key;
            unpack(data, out);
            ret true;
        }
        way = way + 1;
    }
    ret false;
}

# the position's own slot keeps the deeper search unless this one is exact;
# a position new to the bucket takes the slot worth least
pub fun store(key: u64, move: Move, score: i64, depth: i64, flag: u8) {
    val first:  i64 = bucket(key);
    var victim: i64 = first;
    var least:  i64 = 1000000;
    var way:    i64 = 0;
    for (way < WAYS) {
        val e:       *Slot = ?TABLE[first + way];
        val current: u64   = e.data;
        if ((e.guard ^ current) == key) {
            if (flag != EXACT && depth < ((current >> 48) & 0xFF)::i64) { ret; }
            victim = first + way;
            brk;
        }
        val value: i64 = worth(e);
        if (value < least) {
            least  = value;
            victim = first + way;
        }
        way = way + 1;
    }
    val data: u64 = pack(move, score, depth, flag);
    TABLE[victim].data  = data;
    TABLE[victim].guard = key ^ data;
}

test stores_probes_prefers_depth {
    clear();
    var out: Entry;
    if (probe(12345, ?out)) { ret 1; }
    store(12345, mv.make(12, 28, mv.QUIET), 42, 5, EXACT);
    if (!probe(12345, ?out))                                    { ret 2; }
    if (out.score != 42 || out.depth != 5 || out.flag != EXACT) { ret 3; }

    # a shallower bound must not displace a deeper entry
    store(12345, mv.make(1, 2, mv.QUIET), -9, 2, LOWER);
    if (!probe(12345, ?out)) { ret 4; }
    if (out.score != 42)     { ret 5; }

    # four positions share a bucket without evicting one another
    clear();
    val step: u64 = BUCKETS::u64;
    store(5, mv.make(1, 2, mv.QUIET), 10, 9, EXACT);
    store(5 + step, mv.make(1, 3, mv.QUIET), 11, 0, LOWER);
    store(5 + step * 2, mv.make(1, 4, mv.QUIET), 12, 6, EXACT);
    store(5 + step * 3, mv.make(1, 5, mv.QUIET), 13, 3, UPPER);
    if (!probe(5, ?out) || !probe(5 + step, ?out) || !probe(5 + step * 2, ?out) || !probe(5 + step * 3, ?out)) { ret 6; }
    # a fifth takes the shallowest slot, the depth-0 one, and nothing deeper
    store(5 + step * 4, mv.make(1, 6, mv.QUIET), 14, 4, EXACT);
    if (!probe(5 + step * 4, ?out) || out.score != 14) { ret 7; }
    if (probe(5 + step, ?out))                         { ret 11; }
    if (!probe(5, ?out) || out.depth != 9)             { ret 12; }
    # three searches later the untouched entries are worth their depth less
    # twelve, and the depth-3 entry, stored again now, its full 3: a new
    # position takes the depth-4 slot (4 - 12), not the fresh shallow one
    new_search();
    new_search();
    new_search();
    store(5 + step * 3, mv.make(1, 5, mv.QUIET), 13, 3, EXACT);
    store(5 + step * 5, mv.make(1, 7, mv.QUIET), 15, 1, EXACT);
    if (!probe(5 + step * 5, ?out))                   { ret 13; }
    if (!probe(5 + step * 3, ?out) || out.depth != 3) { ret 14; }
    if (probe(5 + step * 4, ?out))                    { ret 15; }

    # negative and mate-range scores survive the packing
    clear();
    store(77, mv.make(5, 6, mv.QUIET), -29997, 9, EXACT);
    if (!probe(77, ?out) || out.score != -29997 || out.depth != 9) { ret 8; }
    store(78, mv.make(7, 8, mv.QUIET), 29997, 63, LOWER);
    if (!probe(78, ?out) || out.score != 29997 || out.depth != 63 || out.flag != LOWER) { ret 9; }

    # a slot corrupted the way a torn write would corrupt it is rejected, not
    # returned: this is the property the guard word exists for
    var way: i64 = 0;
    for (way < WAYS) {
        TABLE[bucket(78) + way].data = TABLE[bucket(78) + way].data ^ 0x1234;
        way                          = way + 1;
    }
    if (probe(78, ?out)) { ret 10; }
    ret 0;
}

test resizes_to_a_power_of_two_and_starts_empty {
    clear();
    store(4242, mv.make(12, 28, mv.QUIET), 7, 6, EXACT);
    var out: Entry;
    if (!probe(4242, ?out)) { ret 1; }
    # 3 MB rounds down to 2: 131,072 slots of 16 bytes, and nothing in them
    if (resize(3) != 2 || MEGABYTES != 2 || ENTRIES != 131072) { ret 2; }
    if (probe(4242, ?out))                                     { ret 3; }
    store(4242, mv.make(12, 28, mv.QUIET), 7, 6, EXACT);
    if (!probe(4242, ?out) || out.score != 7) { ret 4; }
    # a gigabyte, used at its far end
    if (resize(1024) != 1024 || ENTRIES != 67108864) { ret 5; }
    val far: u64 = (BUCKETS - 1)::u64;
    store(far, mv.make(1, 2, mv.QUIET), 9, 3, EXACT);
    if (!probe(far, ?out) || out.score != 9) { ret 6; }
    # asking for the size it has empties it
    if (resize(1024) != 1024 || probe(far, ?out))       { ret 7; }
    if (resize(DEFAULT_MEGABYTES) != DEFAULT_MEGABYTES) { ret 8; }
    ret 0;
}
