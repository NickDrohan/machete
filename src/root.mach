# machete: a UCI chess engine
#
#   machete                          speak UCI on stdin/stdout
#   machete perft  <depth> [fen]        count leaf nodes
#   machete divide <depth> [fen]        per-root-move counts, for comparing with a reference
#   machete go     <depth> [fen]        search one position and print the move
#   machete smp    <threads> <ms> [fen] search with a thread pool and report its rate
#   machete bench                       fixed-depth node-count signature
#   machete magics                      search for magic constants and print them
#
# the FEN may be given as separate arguments; they are joined with spaces.

use std.print;
use std.runtime;
use std.text.parse;
use std.types.result.res;
use std.types.string.str;
use std.types.string.str_equals;

use machete.clock;
use machete.magic;
use mv: machete.move;
use machete.movegen;
use machete.perft;
use pos: machete.position;
use machete.position.Position;
use machete.search;
use machete.see;
use machete.smp;
use machete.tt;
use machete.uci;

val EXIT_USAGE: i64 = 1;

fun usage() i64 {
    print.eprintln("usage: machete                            (UCI mode)");
    print.eprintln("       machete perft  <depth> [fen]          leaf node count");
    print.eprintln("       machete divide <depth> [fen]          per-root-move counts");
    print.eprintln("       machete go     <depth> [fen]          search one position");
    print.eprintln("       machete smp    <threads> <ms> [fen]   search with a thread pool");
    print.eprintln("       machete bench                         node-count signature");
    print.eprintln("       machete magics                        regenerate magic constants");
    ret EXIT_USAGE;
}

# join argv[first..] with spaces into out (capacity cap), or copy the start position
fun fen_from_args(argc: i64, argv: **u8, first: i64, out: *u8, cap: i64) {
    if (first >= argc) {
        var i: i64 = 0;
        for (pos.START_FEN[i] != 0) {
            out[i] = pos.START_FEN[i];
            i      = i + 1;
        }
        out[i] = 0;
        ret;
    }
    var n: i64 = 0;
    var a: i64 = first;
    for (a < argc) {
        if (a > first && n < cap - 1) {
            out[n] = ' ';
            n      = n + 1;
        }
        val arg: str = argv[a];
        var i:   i64 = 0;
        for (arg[i] != 0 && n < cap - 1) {
            out[n] = arg[i];
            n      = n + 1;
            i      = i + 1;
        }
        a = a + 1;
    }
    out[n] = 0;
}

fun counting(argc: i64, argv: **u8, split: u8) i64 {
    if (argc < 3) { ret usage(); }
    val depth: res[i64, parse.ParseError] = parse.parse_i64_exact(argv[2], 10);
    if (sel depth.err) { ret usage(); }
    if (depth.ok < 1)  { ret usage(); }

    var fen: [256]u8;
    fen_from_args(argc, argv, 3, ?fen[0], 256);
    var p: Position;
    if (!pos.set_fen(?p, ?fen[0])) {
        print.eprintln("invalid FEN");
        ret EXIT_USAGE;
    }
    if (split != 0) {
        perft.divide(?p, depth.ok);
    }
    or {
        print.printlnf("{}", perft.perft(?p, depth.ok));
    }
    ret 0;
}

# search one position and print the move, for inspection from the shell
fun go(argc: i64, argv: **u8) i64 {
    if (argc < 3) { ret usage(); }
    val depth: res[i64, parse.ParseError] = parse.parse_i64_exact(argv[2], 10);
    if (sel depth.err) { ret usage(); }
    if (depth.ok < 1)  { ret usage(); }

    var fen: [256]u8;
    fen_from_args(argc, argv, 3, ?fen[0], 256);
    var p: Position;
    if (!pos.set_fen(?p, ?fen[0])) {
        print.eprintln("invalid FEN");
        ret EXIT_USAGE;
    }
    tt.clear();
    var s: search.Search;
    search.reset(?s);
    var limits: search.Limits;
    limits.depth = depth.ok;
    val best:    mv.Move = search.think(?s, ?p, ?limits);
    var spelled: [6]u8;
    mv.to_uci(best, ?spelled[0]);
    print.printlnf("bestmove {}", ?spelled[0]);
    ret 0;
}

# positions the benchmark searches: the opening, the standard perft positions,
# and two endgames, so the node count covers more than one kind of position
val BENCH_FENS: [6]str = [6]str{
    "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1",
    "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1",
    "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - - 0 1",
    "r3k2r/Pppp1ppp/1b3nbN/nP6/BBP1P3/q4N2/Pp1P2PP/R2Q1RK1 w kq - 0 1",
    "r4rk1/1pp1qppp/p1np1n2/2b1p1B1/2B1P1b1/P1NP1N2/1PP1QPPP/R4RK1 w - - 0 10",
    "8/2k5/8/8/3P4/8/5K2/8 w - - 0 1"
};

pub val BENCH_DEPTH: i64 = 8;

# search a fixed set of positions to a fixed depth and print the node total
#
# the total is a signature of the search: any change to move ordering, pruning
# or evaluation moves it. it goes to stdout and the timing to stderr, so the
# pinned fixture stays machine-independent.
fun bench() i64 {
    var total: i64 = 0;
    val start: i64 = clock.now_ms();
    var i:     i64 = 0;
    for (i < 6) {
        var p: Position;
        if (!pos.set_fen(?p, BENCH_FENS[i])) { ret EXIT_USAGE; }
        tt.clear();
        var s: search.Search;
        total = total + search.search_depth(?p, BENCH_DEPTH, ?s);
        i     = i + 1;
    }
    val elapsed: i64 = clock.now_ms() - start;
    print.printlnf("bench depth {} nodes {}", BENCH_DEPTH, total);
    var nps: i64 = 0;
    if (elapsed > 0) { nps = total * 1000 / elapsed; }
    print.eprintlnf("time {} ms, {} nodes/s", elapsed, nps);
    ret 0;
}

# search one position for a fixed time with N threads, and report what the
# whole pool did: `machete smp <threads> <milliseconds> [fen]`
fun smp_bench(argc: i64, argv: **u8) i64 {
    if (argc < 4) { ret usage(); }
    val threads: res[i64, parse.ParseError] = parse.parse_i64_exact(argv[2], 10);
    val ms:      res[i64, parse.ParseError] = parse.parse_i64_exact(argv[3], 10);
    if (sel threads.err) { ret usage(); }
    if (sel ms.err)      { ret usage(); }

    var fen: [256]u8;
    fen_from_args(argc, argv, 4, ?fen[0], 256);
    var p: Position;
    if (!pos.set_fen(?p, ?fen[0])) {
        print.eprintln("invalid FEN");
        ret EXIT_USAGE;
    }

    tt.clear();
    var s: search.Search;
    search.reset(?s);
    s.quiet = 1;
    var limits: search.Limits;
    limits.movetime = ms.ok;

    val start: i64     = clock.now_ms();
    val best:  mv.Move = smp.think(?s, ?p, ?limits, threads.ok);
    val spent: i64     = clock.now_ms() - start;

    val helpers: i64 = smp.helper_nodes(threads.ok);
    val total:   i64 = s.nodes + helpers;
    var nps:     i64 = 0;
    if (spent > 0) { nps = total * 1000 / spent; }
    var spelled: [6]u8;
    mv.to_uci(best, ?spelled[0]);
    print.printlnf("threads {} time {} ms depth {} main_nodes {} helper_nodes {} total {} nps {} bestmove {}",
        threads.ok, spent, s.depth_reached, s.nodes, helpers, total, nps, ?spelled[0]);
    ret 0;
}

# static exchange value of one capture: `machete see <move> <fen...>`
fun see_of(argc: i64, argv: **u8) i64 {
    if (argc < 4) { ret usage(); }
    var fen: [256]u8;
    fen_from_args(argc, argv, 3, ?fen[0], 256);
    var p: Position;
    if (!pos.set_fen(?p, ?fen[0])) {
        print.eprintln("invalid FEN");
        ret EXIT_USAGE;
    }
    val m: mv.Move = movegen.parse_uci(?p, argv[2]);
    if (m == mv.NONE) {
        print.eprintln("not a legal move in this position");
        ret EXIT_USAGE;
    }
    print.printlnf("see {}", see.evaluate(?p, m));
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    pos.init();
    if (argc < 2) { ret uci.loop(); }
    val command: str = argv[1];
    if (str_equals(command, "perft"))  { ret counting(argc, argv, 0); }
    if (str_equals(command, "divide")) { ret counting(argc, argv, 1); }
    if (str_equals(command, "go"))     { ret go(argc, argv); }
    if (str_equals(command, "bench"))  { ret bench(); }
    if (str_equals(command, "smp"))    { ret smp_bench(argc, argv); }
    if (str_equals(command, "see"))    { ret see_of(argc, argv); }
    if (str_equals(command, "magics")) {
        magic.print_found();
        ret 0;
    }
    ret usage();
}
