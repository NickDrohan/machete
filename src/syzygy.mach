var BINOMIAL:     [7][64]i64;
var PAWN_IDX:     [6][24]i64;
var PAWN_FACTOR:  [6][4]i64;
var tables_ready: bool = false;

fun init_indices() {
    if (tables_ready) { ret; }
    var i: i64 = 0;
    for (i < 7) {
        var j: i64 = 0;
        for (j < 64) {
            var f: i64 = 1;
            var l: i64 = 1;
            var k: i64 = 0;
            for (k < i) {
                f = f * (j - k);
                l = l * (k + 1);
                k = k + 1;
            }
            BINOMIAL[i][j] = f / l;
            j              = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < 6) {
        var s: i64 = 0;
        var j: i64 = 0;
        for (j < 24) {
            PAWN_IDX[i][j] = s;
            s              = s + BINOMIAL[i][PAWN_TWIST[(1 + (j % 6)) * 8 + (j / 6)]::i64];
            if ((j + 1) % 6 == 0) {
                PAWN_FACTOR[i][j / 6] = s;
                s                     = 0;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    tables_ready = true;
}

# ---- tables in memory ----

# one compressed block stream (de Man's "pairs"): offsets are into the table's bytes
rec Pairs {
    constant:    i64; # the value when idx_bits is 0 (the whole table is one value)
    idx_bits:    i64;
    block_size:  i64;
    min_len:     i64;
    index_table: i64;
    size_table:  i64;
    data:        i64;
    offset:      i64; # the u16 symbol offsets, by code length from min_len
    sym_pat:     i64;
    sym_len:     i64; # into SYM_LEN
    base:        [64]u64;
}

rec Enc {
    pairs:  Pairs;
    factor: [8]i64;
    pieces: [8]u8;
    norm:   [8]u8;
}

rec Table {
    bytes:     *u8;
    num:       i64;
    symmetric: bool;
    has_pawns: bool;
    kk_enc:    bool;
    pawns:     [2]i64;
    key:       u64;
    enc:       [8]Enc;
}

var TABLES:  [256]Table;
var COUNT:   i64 = 0;
var SYM_LEN: [16777216]u8;
var SYM_TOP: i64 = 0;

# material key -> table index + 1, open addressing
var KEYS:  [1024]u64;
var SLOTS: [1024]i64;

var PAGES:       allocator.Allocator;
var PAGES_READY: bool = false;

fun u16_le(t: *Table, at: i64) i64 {
    ret t.bytes[at]::i64 | (t.bytes[at + 1]::i64 << 8);
}

fun u32_le(t: *Table, at: i64) i64 {
    ret u16_le(t, at) | (u16_le(t, at + 2) << 16);
}

fun u32_be(t: *Table, at: i64) u64 {
    ret (t.bytes[at]::u64 << 24) | (t.bytes[at + 1]::u64 << 16) | (t.bytes[at + 2]::u64 << 8) | t.bytes[at + 3]::u64;
}

# a material key: piece counts by colour and kind (pawn to queen), four bits each; kings are always one each
fun key_of_counts(counts: *i64, mirror: bool) u64 {
    var k: u64 = 0;
    var c: i64 = 0;
    for (c < 2) {
        var kind: i64 = 0;
        for (kind < 5) {
            var colour: i64 = c;
            if (mirror) { colour = 1 - c; }
            k    = k | (counts[c * 6 + kind]::u64 << ((colour * 5 + kind) * 4)::u64);
            kind = kind + 1;
        }
        c = c + 1;
    }
    ret k;
}

fun key_of_position(p: *Position) u64 {
    var counts: [12]i64;
    var i:      i64 = 0;
    for (i < 12) {
        counts[i] = bb.count(p.pieces[i]);
        i         = i + 1;
    }
    ret key_of_counts(?counts[0], false);
}

fun slot_of(key: u64) i64 {
    var at: i64 = ((key * 0x9E3779B97F4A7C15) >> 54)::i64;
    for (KEYS[at] != 0 && KEYS[at] != key) { at = (at + 1) & 1023; }
    ret at;
}

fun register(key: u64, index: i64) {
    val at: i64 = slot_of(key);
    KEYS[at]  = key;
    SLOTS[at] = index + 1;
}

# ---- reading a table file ----

fun read_file(path: *u8, out: **u8) bool {
    if (!PAGES_READY) {
        val made: err[allocator.Error] = page.make(?PAGES);
        if (sel made.err) { ret false; }
        PAGES_READY = true;
    }
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret false; }
    var f:    fs.File             = opened.ok;
    val ok:   bool                = read_all(f, out);
    val shut: err[io_error.Error] = fs.close(?f);
    ret ok;
}

fun read_all(f: fs.File, out: **u8) bool {
    val end: res[i64, io_error.Error] = fs.seek(f, 0, 2);
    if (sel end.err) { ret false; }
    val size: i64 = end.ok;
    if (size <= 8) { ret false; }
    val start: res[i64, io_error.Error] = fs.seek(f, 0, 0);
    if (sel start.err) { ret false; }
    val got: res[*u8, allocator.Error] = allocator.zallocate[u8](?PAGES, (size + 64)::usize);
    if (sel got.err) { ret false; }
    val buf: *u8 = got.ok;
    var at:  i64 = 0;
    for (at < size) {
        val n: res[usize, io_error.Error] = fs.read(f, ?buf[at], (size - at)::usize);
        if (sel n.err)      { ret false; }
        if (n.ok::i64 == 0) { ret false; }
        at = at + n.ok::i64;
    }
    @out = buf;
    ret true;
}

fun subfactor(k: i64, n: i64) i64 {
    var f: i64 = n;
    var l: i64 = 1;
    var i: i64 = 1;
    for (i < k) {
        f = f * (n - i);
        l = l * (i + 1);
        i = i + 1;
    }
    ret f / l;
}

# the piece order, the groups of like pieces and the index factors of one subtable, from its header at `at`
fun init_enc(t: *Table, e: *Enc, at: i64, shift: i64, file: i64) i64 {
    val more: i64 = (t.has_pawns && t.pawns[1] > 0)::i64;
    var i:    i64 = 0;
    for (i < 8) {
        e.norm[i]   = 0;
        e.pieces[i] = 0;
        i           = i + 1;
    }
    i = 0;
    for (i < t.num) {
        e.pieces[i] = ((t.bytes[at + i + 1 + more] >> shift::u8) & 15);
        i           = i + 1;
    }
    val order:  i64 = ((t.bytes[at] >> shift::u8) & 15)::i64;
    var order2: i64 = 15;
    if (more != 0) { order2 = ((t.bytes[at + 1] >> shift::u8) & 15)::i64; }
    var k: i64 = 3;
    if (t.has_pawns) { k = t.pawns[0]; }
    or (t.kk_enc)    { k = 2; }
    e.norm[0] = k::u8;
    if (more != 0) {
        e.norm[k] = t.pawns[1]::u8;
        k         = k + t.pawns[1];
    }
    i = k;
    for (i < t.num) {
        var j: i64 = i;
        for (j < t.num && e.pieces[j] == e.pieces[i]) {
            e.norm[i] = e.norm[i] + 1;
            j         = j + 1;
        }
        i = i + e.norm[i]::i64;
    }
    var n: i64 = 64 - k;
    var f: i64 = 1;
    i = 0;
    for (k < t.num || i == order || i == order2) {
        if (i == order) {
            e.factor[0] = f;
            if (t.has_pawns) { f = f * PAWN_FACTOR[e.norm[0]::i64 - 1][file]; }
            or (t.kk_enc)    { f = f * 462; }
            or               { f = f * 31332; }
        }
        or (i == order2) {
            e.factor[e.norm[0]::i64] = f;
            f                        = f * subfactor(e.norm[e.norm[0]::i64]::i64, 48 - e.norm[0]::i64);
        }
        or {
            e.factor[k] = f;
            f           = f * subfactor(e.norm[k]::i64, n);
            n           = n - e.norm[k]::i64;
            k           = k + e.norm[k]::i64;
        }
        i = i + 1;
    }
    ret f;
}

fun sym_len_of(d: *Pairs, s: i64, done: *u8, t: *Table) {
    val w:  i64 = d.sym_pat + 3 * s;
    val s2: i64 = (t.bytes[w + 2]::i64 << 4) | (t.bytes[w + 1]::i64 >> 4);
    if (s2 == 0x0fff) {
        SYM_LEN[d.sym_len + s] = 0;
    }
    or {
        val s1: i64 = ((t.bytes[w + 1]::i64 & 15) << 8) | t.bytes[w]::i64;
        if (done[s1] == 0) { sym_len_of(d, s1, done, t); }
        if (done[s2] == 0) { sym_len_of(d, s2, done, t); }
        SYM_LEN[d.sym_len + s] = (SYM_LEN[d.sym_len + s1]::i64 + SYM_LEN[d.sym_len + s2]::i64 + 1)::u8;
    }
    done[s] = 1;
}

var DONE: [4096]u8;

# one subtable's compression header at `at`; sizes[0..2] receive its index, size and data lengths. Returns the
# offset after the header, or -1 when the table cannot be read
fun setup_pairs(t: *Table, d: *Pairs, at: i64, tb_size: i64, sizes: *i64) i64 {
    if ((t.bytes[at] & 0x80) != 0) {
        d.idx_bits = 0;
        d.constant = t.bytes[at + 1]::i64;
        sizes[0]   = 0;
        sizes[1]   = 0;
        sizes[2]   = 0;
        ret at + 2;
    }
    d.block_size = t.bytes[at + 1]::i64;
    d.idx_bits   = t.bytes[at + 2]::i64;
    val real_blocks: i64 = u32_le(t, at + 4);
    val blocks:      i64 = real_blocks + t.bytes[at + 3]::i64;
    val max_len:     i64 = t.bytes[at + 8]::i64;
    d.min_len = t.bytes[at + 9]::i64;
    val h:    i64 = max_len - d.min_len + 1;
    val syms: i64 = u16_le(t, at + 10 + 2 * h);
    if (h > 64 || syms > 4096 || SYM_TOP + syms > MAX_SYMBOLS_POOL) { ret 0 - 1; }
    d.offset  = at + 10;
    d.sym_pat = at + 12 + 2 * h;
    d.sym_len = SYM_TOP;
    SYM_TOP   = SYM_TOP + syms;
    val indices: i64 = (tb_size + (1 << d.idx_bits) - 1) >> d.idx_bits;
    sizes[0] = 6 * indices;
    sizes[1] = 2 * blocks;
    sizes[2] = real_blocks << d.block_size;
    var s: i64 = 0;
    for (s < syms) {
        DONE[s] = 0;
        s       = s + 1;
    }
    s = 0;
    for (s < syms) {
        if (DONE[s] == 0) { sym_len_of(d, s, ?DONE[0], t); }
        s = s + 1;
    }
    d.base[h - 1] = 0;
    var i: i64 = h - 2;
    for (i >= 0) {
        d.base[i] = (d.base[i + 1] + u16_le(t, d.offset + 2 * i)::u64 - u16_le(t, d.offset + 2 * (i + 1))::u64) / 2;
        i         = i - 1;
    }
    i = 0;
    for (i < h) {
        d.base[i] = d.base[i] << (64 - (d.min_len + i))::u64;
        i         = i + 1;
    }
    ret at + 12 + 2 * h + 3 * syms + (syms & 1);
}

fun parse(t: *Table) bool {
    if (u32_le(t, 0) != 0x5d23e871) { ret false; }
    val split: bool = (t.bytes[4] & 1) != 0;
    var at:    i64  = 5;
    var num:   i64  = 1;
    if (t.has_pawns) { num = 4; }
    var size: [8]i64;
    var f:    i64 = 0;
    for (f < num) {
        size[f] = init_enc(t, ?t.enc[f], at, 0, f);
        if (split) { size[num + f] = init_enc(t, ?t.enc[num + f], at, 4, f); }
        at = at + t.num + 1 + (t.has_pawns && t.pawns[1] > 0)::i64;
        f  = f + 1;
    }
    at = at + (at & 1);
    var sizes: [8][3]i64;
    f = 0;
    for (f < num) {
        at = setup_pairs(t, ?t.enc[f].pairs, at, size[f], ?sizes[f][0]);
        if (at < 0) { ret false; }
        if (split) {
            at = setup_pairs(t, ?t.enc[num + f].pairs, at, size[num + f], ?sizes[num + f][0]);
            if (at < 0) { ret false; }
        }
        f = f + 1;
    }
    f = 0;
    for (f < num) {
        t.enc[f].pairs.index_table = at;
        at                         = at + sizes[f][0];
        if (split) {
            t.enc[num + f].pairs.index_table = at;
            at                               = at + sizes[num + f][0];
        }
        f = f + 1;
    }
    f = 0;
    for (f < num) {
        t.enc[f].pairs.size_table = at;
        at                        = at + sizes[f][1];
        if (split) {
            t.enc[num + f].pairs.size_table = at;
            at                              = at + sizes[num + f][1];
        }
        f = f + 1;
    }
    f = 0;
    for (f < num) {
        at                  = (at + 63) & (0 - 64);
        t.enc[f].pairs.data = at;
        at                  = at + sizes[f][2];
        if (split) {
            at                        = (at + 63) & (0 - 64);
            t.enc[num + f].pairs.data = at;
            at                        = at + sizes[num + f][2];
        }
        f = f + 1;
    }
    if (!split) {
        # one side only (a symmetric table): both sides read the same subtables
        f = 0;
        for (f < num) {
            t.enc[num + f] = t.enc[f];
            f              = f + 1;
        }
    }
    ret true;
}

# ---- loading a directory ----

val NAME_CHARS: str = "PNBRQ";

# the table name for these counts (white's men then black's: K then Q R B N P) into out, after `dir`; returns the length
fun name_of(dir: *u8, counts: *i64, out: *u8, ext: str) i64 {
    var n: i64 = 0;
    for (dir[n] != 0) {
        out[n] = dir[n];
        n      = n + 1;
    }
    if (n > 0 && out[n - 1] != '/' && out[n - 1] != '\\') {
        out[n] = '/';
        n      = n + 1;
    }
    var c: i64 = 0;
    for (c < 2) {
        if (c == 1) {
            out[n] = 'v';
            n      = n + 1;
        }
        out[n] = 'K';
        n      = n + 1;
        var kind: i64 = 4;
        for (kind >= 0) {
            var k: i64 = 0;
            for (k < counts[c * 6 + kind]) {
                out[n] = NAME_CHARS[kind];
                n      = n + 1;
                k      = k + 1;
            }
            kind = kind - 1;
        }
        c = c + 1;
    }
    var e: i64 = 0;
    for (e < 5) {
        out[n] = ext[e];
        n      = n + 1;
        e      = e + 1;
    }
    out[n] = 0;
    ret n;
}

fun try_table(dir: *u8, counts: *i64) {
    if (COUNT >= MAX_TABLES) { ret; }
    var path: [1024]u8;
    name_of(dir, counts, ?path[0], ".rtbw");
    val t: *Table = ?TABLES[COUNT];
    if (!read_file(?path[0], ?t.bytes)) { ret; }
    var num:     i64 = 2;
    var singles: i64 = 2;
    var i:       i64 = 0;
    for (i < 12) {
        if (i % 6 != 5) {
            num = num + counts[i];
            if (counts[i] == 1) { singles = singles + 1; }
        }
        i = i + 1;
    }
    t.num       = num;
    t.has_pawns = counts[0] + counts[6] > 0;
    t.kk_enc    = singles == 2;
    t.pawns[0]  = counts[0];
    t.pawns[1]  = counts[6];
    if (counts[6] > 0 && (counts[0] == 0 || counts[0] > counts[6])) {
        t.pawns[0] = counts[6];
        t.pawns[1] = counts[0];
    }
    t.key = key_of_counts(counts, false);
    val other: u64 = key_of_counts(counts, true);
    t.symmetric = t.key == other;
    if (!parse(t)) { ret; }
    register(t.key, COUNT);
    if (!t.symmetric) { register(other, COUNT); }
    COUNT = COUNT + 1;
    if (num > LARGEST) { LARGEST = num; }
}

# every combination of up to `men` men (kings included), white the stronger or equal side as the files are named
fun try_all(dir: *u8, counts: *i64, slot: i64, left: i64) {
    if (slot == 10) {
        try_table(dir, counts);
        try_dtz(dir, counts);
        ret;
    }
    val index: i64 = (slot / 5) * 6 + (slot % 5);
    var n:     i64 = 0;
    for (n <= left) {
        counts[index] = n;
        try_all(dir, counts, slot + 1, left - n);
        n = n + 1;
    }
    counts[index] = 0;
}

# load every WDL and DTZ table of up to five men in `dir`; returns how many WDL tables were found (DTZ_TABLES says
# how many DTZ). Called between searches only.
pub fun load(dir: *u8) i64 {
    init_indices();
    COUNT      = 0;
    DCOUNT     = 0;
    DTZ_TABLES = 0;
    LARGEST    = 0;
    SYM_TOP    = 0;
    var i: i64 = 0;
    for (i < 1024) {
        KEYS[i]   = 0;
        SLOTS[i]  = 0;
        DKEYS[i]  = 0;
        DSLOTS[i] = 0;
        i         = i + 1;
    }
    var counts: [12]i64;
    i = 0;
    for (i < 12) {
        counts[i] = 0;
        i         = i + 1;
    }
    try_all(dir, ?counts[0], 0, 3);
    ret COUNT;
}

# ---- probing ----

# the offset of the symbol pattern holding entry idx; the caller has dealt with a constant table
fun decompress_at(t: *Table, d: *Pairs, idx: i64) i64 {
    val main:  i64 = idx >> d.idx_bits;
    var lit:   i64 = (idx & ((1 << d.idx_bits) - 1)) - (1 << (d.idx_bits - 1));
    var block: i64 = u32_le(t, d.index_table + 6 * main);
    lit = lit + u16_le(t, d.index_table + 6 * main + 4);
    if (lit < 0) {
        for (lit < 0) {
            block = block - 1;
            lit   = lit + u16_le(t, d.size_table + 2 * block) + 1;
        }
    }
    or {
        for (lit > u16_le(t, d.size_table + 2 * block)) {
            lit   = lit - u16_le(t, d.size_table + 2 * block) - 1;
            block = block + 1;
        }
    }
    var at:   i64 = d.data + (block << d.block_size);
    var code: u64 = (u32_be(t, at) << 32) | u32_be(t, at + 4);
    at = at + 8;
    var bits: i64 = 0;
    val m:    i64 = d.min_len;
    var sym:  i64 = 0;
    for {
        var l: i64 = m;
        for (code < d.base[l - m]) { l = l + 1; }
        sym = u16_le(t, d.offset + 2 * (l - m)) + ((code - d.base[l - m]) >> (64 - l)::u64)::i64;
        val len: i64 = SYM_LEN[d.sym_len + sym]::i64;
        if (lit < len + 1) { brk; }
        lit  = lit - len - 1;
        code = code << l::u64;
        bits = bits + l;
        if (bits >= 32) {
            bits = bits - 32;
            code = code | (u32_be(t, at) << bits::u64);
            at   = at + 4;
        }
    }
    for (SYM_LEN[d.sym_len + sym] != 0) {
        val w:  i64 = d.sym_pat + 3 * sym;
        val s1: i64 = ((t.bytes[w + 1]::i64 & 15) << 8) | t.bytes[w]::i64;
        val l1: i64 = SYM_LEN[d.sym_len + s1]::i64;
        if (lit < l1 + 1) {
            sym = s1;
        }
        or {
            lit = lit - l1 - 1;
            sym = (t.bytes[w + 2]::i64 << 4) | (t.bytes[w + 1]::i64 >> 4);
        }
    }
    ret d.sym_pat + 3 * sym;
}

# a WDL entry: one byte
fun decompress(t: *Table, d: *Pairs, idx: i64) i64 {
    if (d.idx_bits == 0) { ret d.constant; }
    ret t.bytes[decompress_at(t, d, idx)]::i64;
}

# a DTZ entry: twelve bits, the low byte and the low nibble of the next (a constant DTZ table holds 0)
fun decompress_dtz(t: *Table, d: *Pairs, idx: i64) i64 {
    if (d.idx_bits == 0) { ret 0; }
    val w: i64 = decompress_at(t, d, idx);
    ret t.bytes[w]::i64 + ((t.bytes[w + 1]::i64 & 15) << 8);
}

# the squares of the men of table piece `code` (1-6 white pawn to king, 9-14 black), colours swapped when flip
fun fill(p: *Position, e: *Enc, flip: bool, mirror: i64, sq: *i64, from: i64) i64 {
    val code:   i64 = e.pieces[from]::i64;
    var colour: i64 = code >> 3;
    if (flip) { colour = 1 - colour; }
    var b: u64 = p.pieces[colour * 6 + (code & 7) - 1];
    var i: i64 = from;
    for (b != 0) {
        sq[i] = bb.lsb(b) ^ mirror;
        b     = b & (b - 1);
        i     = i + 1;
    }
    ret i;
}

fun swap(a: *i64, i: i64, j: i64) {
    val x: i64 = a[i];
    a[i] = a[j];
    a[j] = x;
}

fun encode(t: *Table, e: *Enc, sq: *i64) i64 {
    val n:   i64 = t.num;
    var idx: i64 = 0;
    var k:   i64 = 0;
    if ((sq[0] & 4) != 0) {
        var i: i64 = 0;
        for (i < n) {
            sq[i] = sq[i] ^ 7;
            i     = i + 1;
        }
    }
    if (!t.has_pawns) {
        if ((sq[0] & 0x20) != 0) {
            var i: i64 = 0;
            for (i < n) {
                sq[i] = sq[i] ^ 0x38;
                i     = i + 1;
            }
        }
        var lead: i64 = 3;
        if (t.kk_enc) { lead = 2; }
        var i: i64 = 0;
        for (i < n) {
            val off: i64 = OFF_DIAG[sq[i]]::i64;
            if (off != 0) {
                if (off > 0 && i < lead) {
                    var j: i64 = 0;
                    for (j < n) {
                        sq[j] = ((sq[j] >> 3) | ((sq[j] & 7) << 3));
                        j     = j + 1;
                    }
                }
                brk;
            }
            i = i + 1;
        }
        if (t.kk_enc) {
            idx = KK_IDX[TRIANGLE[sq[0]]::i64 * 64 + sq[1]]::i64;
            k   = 2;
        }
        or {
            val s1: i64 = (sq[1] > sq[0])::i64;
            val s2: i64 = (sq[2] > sq[0])::i64 + (sq[2] > sq[1])::i64;
            if (OFF_DIAG[sq[0]] != 0) {
                idx = TRIANGLE[sq[0]]::i64 * 63 * 62 + (sq[1] - s1) * 62 + (sq[2] - s2);
            }
            or (OFF_DIAG[sq[1]] != 0) {
                idx = 6 * 63 * 62 + DIAG[sq[0]]::i64 * 28 * 62 + LOWER[sq[1]]::i64 * 62 + sq[2] - s2;
            }
            or (OFF_DIAG[sq[2]] != 0) {
                idx = 6 * 63 * 62 + 4 * 28 * 62 + DIAG[sq[0]]::i64 * 7 * 28 + (DIAG[sq[1]]::i64 - s1) * 28 + LOWER[sq[2]]::i64;
            }
            or {
                idx = 6 * 63 * 62 + 4 * 28 * 62 + 4 * 7 * 28 + DIAG[sq[0]]::i64 * 7 * 6 + (DIAG[sq[1]]::i64 - s1) * 6 + (DIAG[sq[2]]::i64 - s2);
            }
            k = 3;
        }
        idx = idx * e.factor[0];
    }
    or {
        var i: i64 = 1;
        for (i < t.pawns[0]) {
            var j: i64 = i + 1;
            for (j < t.pawns[0]) {
                if (PAWN_TWIST[sq[i]] < PAWN_TWIST[sq[j]]) { swap(sq, i, j); }
                j = j + 1;
            }
            i = i + 1;
        }
        k   = t.pawns[0];
        idx = PAWN_IDX[k - 1][FLAP[sq[0]]::i64];
        i   = 1;
        for (i < k) {
            idx = idx + BINOMIAL[k - i][PAWN_TWIST[sq[i]]::i64];
            i   = i + 1;
        }
        idx = idx * e.factor[0];
        if (t.pawns[1] > 0) {
            val end: i64 = k + t.pawns[1];
            i = k;
            for (i < end) {
                var j: i64 = i + 1;
                for (j < end) {
                    if (sq[i] > sq[j]) { swap(sq, i, j); }
                    j = j + 1;
                }
                i = i + 1;
            }
            var s: i64 = 0;
            i = k;
            for (i < end) {
                var skips: i64 = 0;
                var j:     i64 = 0;
                for (j < k) {
                    skips = skips + (sq[i] > sq[j])::i64;
                    j     = j + 1;
                }
                s = s + BINOMIAL[i - k + 1][sq[i] - skips - 8];
                i = i + 1;
            }
            idx = idx + s * e.factor[k];
            k   = end;
        }
    }
    for (k < n) {
        val end: i64 = k + e.norm[k]::i64;
        var i:   i64 = k;
        for (i < end) {
            var j: i64 = i + 1;
            for (j < end) {
                if (sq[i] > sq[j]) { swap(sq, i, j); }
                j = j + 1;
            }
            i = i + 1;
        }
        var s: i64 = 0;
        i = k;
        for (i < end) {
            var skips: i64 = 0;
            var j:     i64 = 0;
            for (j < k) {
                skips = skips + (sq[i] > sq[j])::i64;
                j     = j + 1;
            }
            s = s + BINOMIAL[i - k + 1][sq[i] - skips];
            i = i + 1;
        }
        idx = idx + s * e.factor[k];
        k   = end;
    }
    ret idx;
}

# the table's value for this position, captures not considered; ok false when there is no table for it
fun probe_table(p: *Position, ok: *bool) i64 {
    val key: u64 = key_of_position(p);
    if (key == 0) { ret 0; }
    val at: i64 = slot_of(key);
    if (SLOTS[at] == 0) {
        @ok = false;
        ret 0;
    }
    val t:     *Table = ?TABLES[SLOTS[at] - 1];
    var flip:  bool   = false;
    var bside: bool   = false;
    if (!t.symmetric) {
        flip  = key != t.key;
        bside = (p.side == pos.WHITE) == flip;
    }
    or {
        flip = p.side != pos.WHITE;
    }
    var sq: [8]i64;
    var e:  *Enc = ?t.enc[0];
    if (!t.has_pawns) {
        if (bside) { e = ?t.enc[1]; }
        var i: i64 = 0;
        for (i < t.num) { i = fill(p, e, flip, 0, ?sq[0], i); }
    }
    or {
        var mirror: i64 = 0;
        if (flip) { mirror = 0x38; }
        var i: i64 = fill(p, e, flip, mirror, ?sq[0], 0);
        var j: i64 = 1;
        for (j < t.pawns[0]) {
            if (FLAP[sq[0]] > FLAP[sq[j]]) { swap(?sq[0], 0, j); }
            j = j + 1;
        }
        var file: i64 = FILE_TO_FILE[sq[0] & 7]::i64;
        if (bside) { file = file + 4; }
        e = ?t.enc[file];
        for (i < t.num) { i = fill(p, e, flip, mirror, ?sq[0], i); }
    }
    ret decompress(t, ?e.pairs, encode(t, e, ?sq[0])) - 2;
}

fun is_capture(m: Move) bool {
    ret mv.is_capture(m) != 0;
}

# the value with captures played out: the table may hold anything for a position whose best move captures
fun probe_ab(p: *Position, alpha_in: i64, beta: i64, ok: *bool) i64 {
    var alpha: i64 = alpha_in;
    var list:  MoveList;
    movegen.generate(p, ?list, true);
    var i: i64 = 0;
    for (i < list.count) {
        val m: Move = list.moves[i];
        i = i + 1;
        if (!is_capture(m)) { cnt; }
        pos.make(p, m);
        if (pos.left_in_check(p)) {
            pos.unmake(p);
            cnt;
        }
        val v: i64 = 0 - probe_ab(p, 0 - beta, 0 - alpha, ok);
        pos.unmake(p);
        if (!@ok) { ret 0; }
        if (v > alpha) {
            if (v >= beta) { ret v; }
            alpha = v;
        }
    }
    val v: i64 = probe_table(p, ok);
    if (alpha >= v) { ret alpha; }
    ret v;
}

# the WDL value with captures resolved, as Fathom's probe_wdl: success is 1, or 2 when a capture (en passant
# included) decides the result, which probe_dtz needs to know; ok false when a table is missing. No guards, no
# accumulator handling: the callers below do both.
fun wdl_full(p: *Position, ok: *bool, success: *i64) i64 {
    @ok      = true;
    @success = 1;
    var list: MoveList;
    movegen.generate(p, ?list, true);
    var best_cap: i64 = 0 - 3;
    var best_ep:  i64 = 0 - 3;
    var i:        i64 = 0;
    for (i < list.count) {
        val m: Move = list.moves[i];
        i = i + 1;
        if (!is_capture(m)) { cnt; }
        pos.make(p, m);
        if (pos.left_in_check(p)) {
            pos.unmake(p);
            cnt;
        }
        val v: i64 = 0 - probe_ab(p, 0 - 2, 0 - best_cap, ok);
        pos.unmake(p);
        if (!@ok) { ret 0; }
        if (v > best_cap) {
            if (v == 2) {
                @success = 2;
                ret 2;
            }
            if (mv.flag(m) != mv.EP_CAPTURE) { best_cap = v; }
            or (v > best_ep)                 { best_ep = v; }
        }
    }
    val v: i64 = probe_table(p, ok);
    if (!@ok) { ret 0; }
    var cap: i64 = best_cap;
    if (best_ep > cap) {
        if (best_ep > v) {
            @success = 2;
            ret best_ep;
        }
        cap = best_ep;
    }
    if (cap >= v) {
        if (cap > 0) { @success = 2; }
        ret cap;
    }
    if (best_ep > 0 - 3 && v == 0) {
        # stalemate without the en passant capture: the capture is the only move, and decides
        var all: MoveList;
        movegen.generate(p, ?all, false);
        var other: bool = false;
        var j:     i64  = 0;
        for (j < all.count && !other) {
            val m: Move = all.moves[j];
            j = j + 1;
            if (mv.flag(m) == mv.EP_CAPTURE) { cnt; }
            pos.make(p, m);
            if (!pos.left_in_check(p)) { other = true; }
            pos.unmake(p);
        }
        if (!other && !pos.in_check(p)) {
            @success = 2;
            ret best_ep;
        }
    }
    ret v;
}

# whether the position is in the tables at all: few enough men, no castling rights, tables loaded
fun probeable(p: *Position) bool {
    ret LARGEST > 0 && p.castling == 0 && bb.count(pos.all(p)) <= LARGEST;
}

# win (2), cursed win (1), draw (0), blessed loss (-1) or loss (-2) for the side to move; ok false when the
# position is not in the tables (too many men, a table missing, castling rights). The caller's accumulator is left
# untouched: the probe moves on a position with no network attached.
pub fun probe_wdl(p: *Position, ok: *bool) i64 {
    @ok = false;
    if (!probeable(p)) { ret 0; }
    val accs: *nn.Acc = p.accs;
    p.accs = nil;
    var success: i64 = 0;
    val result:  i64 = wdl_full(p, ok, ?success);
    p.accs = accs;
    if (!@ok) { ret 0; }
    ret result;
}

# ---- distance to zeroing (DTZ) ----

# Fathom's constants: the map that applies to each WDL value, and the flag bit that says a value is stored in moves,
# not plies (from win, from loss); WDL_TO_DTZ is the DTZ of a position whose best move zeroes the counter
val WDL_TO_MAP: [5]i64 = [5]i64{1, 3, 0, 2, 0};
val PA_FLAGS:   [5]i64 = [5]i64{8, 0, 0, 0, 4};
val WDL_TO_DTZ: [5]i64 = [5]i64{-1, -101, 0, 101, 1};

# one DTZ table: the WDL table's layout for one side to move (flags bit 0 says which), the map of stored values to
# DTZ for each WDL value (flags bit 1; bit 4 when its entries are 16 bits), per file for pawn tables
rec Dtz {
    t:       Table;
    flags:   [4]u8;
    map:     i64;
    map_idx: [4][4]i64;
}

var DTZS:   [256]Dtz;
var DCOUNT: i64 = 0;
var DKEYS:  [1024]u64;
var DSLOTS: [1024]i64;

# how many DTZ tables are loaded; the root ranks moves by DTZ only when there are some
pub var DTZ_TABLES: i64 = 0;

fun dslot_of(key: u64) i64 {
    var at: i64 = ((key * 0x9E3779B97F4A7C15) >> 54)::i64;
    for (DKEYS[at] != 0 && DKEYS[at] != key) { at = (at + 1) & 1023; }
    ret at;
}

fun dregister(key: u64, index: i64) {
    val at: i64 = dslot_of(key);
    DKEYS[at]  = key;
    DSLOTS[at] = index + 1;
}

# Fathom's init_table for DTZ: one subtable per file (one for pawnless), no split, then the value maps
fun parse_dtz(d: *Dtz) bool {
    val t: *Table = ?d.t;
    if (u32_le(t, 0) != 0xa50c66d7) { ret false; }
    var at:  i64 = 5;
    var num: i64 = 1;
    if (t.has_pawns) { num = 4; }
    var size: [4]i64;
    var f:    i64 = 0;
    for (f < num) {
        size[f] = init_enc(t, ?t.enc[f], at, 0, f);
        at      = at + t.num + 1 + (t.has_pawns && t.pawns[1] > 0)::i64;
        f       = f + 1;
    }
    at = at + (at & 1);
    var sizes: [4][3]i64;
    f = 0;
    for (f < num) {
        d.flags[f] = t.bytes[at];
        at         = setup_pairs(t, ?t.enc[f].pairs, at, size[f], ?sizes[f][0]);
        if (at < 0) { ret false; }
        # a constant DTZ table holds 0, whatever its header byte says (Fathom's constValue for DTZ)
        if (t.enc[f].pairs.idx_bits == 0) { t.enc[f].pairs.constant = 0; }
        f = f + 1;
    }
    d.map = at;
    f     = 0;
    for (f < num) {
        if ((d.flags[f] & 2) != 0) {
            var i: i64 = 0;
            if ((d.flags[f] & 16) == 0) {
                for (i < 4) {
                    d.map_idx[f][i] = at + 1 - d.map;
                    at              = at + 1 + t.bytes[at]::i64;
                    i               = i + 1;
                }
            }
            or {
                at = at + (at & 1);
                for (i < 4) {
                    d.map_idx[f][i] = ((at - d.map) >> 1) + 1;
                    at              = at + 2 + 2 * u16_le(t, at);
                    i               = i + 1;
                }
            }
        }
        f = f + 1;
    }
    at = at + (at & 1);
    f  = 0;
    for (f < num) {
        t.enc[f].pairs.index_table = at;
        at                         = at + sizes[f][0];
        f                          = f + 1;
    }
    f = 0;
    for (f < num) {
        t.enc[f].pairs.size_table = at;
        at                        = at + sizes[f][1];
        f                         = f + 1;
    }
    f = 0;
    for (f < num) {
        at                  = (at + 63) & (0 - 64);
        t.enc[f].pairs.data = at;
        at                  = at + sizes[f][2];
        f                   = f + 1;
    }
    ret true;
}

fun try_dtz(dir: *u8, counts: *i64) {
    if (DCOUNT >= MAX_TABLES) { ret; }
    var path: [1024]u8;
    name_of(dir, counts, ?path[0], ".rtbz");
    val d: *Dtz   = ?DTZS[DCOUNT];
    val t: *Table = ?d.t;
    if (!read_file(?path[0], ?t.bytes)) { ret; }
    var num:     i64 = 2;
    var singles: i64 = 2;
    var i:       i64 = 0;
    for (i < 12) {
        if (i % 6 != 5) {
            num = num + counts[i];
            if (counts[i] == 1) { singles = singles + 1; }
        }
        i = i + 1;
    }
    t.num       = num;
    t.has_pawns = counts[0] + counts[6] > 0;
    t.kk_enc    = singles == 2;
    t.pawns[0]  = counts[0];
    t.pawns[1]  = counts[6];
    if (counts[6] > 0 && (counts[0] == 0 || counts[0] > counts[6])) {
        t.pawns[0] = counts[6];
        t.pawns[1] = counts[0];
    }
    t.key = key_of_counts(counts, false);
    val other: u64 = key_of_counts(counts, true);
    t.symmetric = t.key == other;
    if (!parse_dtz(d)) { ret; }
    dregister(t.key, DCOUNT);
    if (!t.symmetric) { dregister(other, DCOUNT); }
    DCOUNT     = DCOUNT + 1;
    DTZ_TABLES = DCOUNT;
}

# the stored DTZ for this position and WDL value; other is set when the table holds the other side to move only
fun probe_dtz_table(p: *Position, wdl: i64, ok: *bool, other: *bool) i64 {
    @other = false;
    val key: u64 = key_of_position(p);
    val at:  i64 = dslot_of(key);
    if (key == 0 || DSLOTS[at] == 0) {
        @ok = false;
        ret 0;
    }
    val d:     *Dtz   = ?DTZS[DSLOTS[at] - 1];
    val t:     *Table = ?d.t;
    var flip:  bool   = false;
    var bside: bool   = false;
    if (!t.symmetric) {
        flip  = key != t.key;
        bside = (p.side == pos.WHITE) == flip;
    }
    or {
        flip = p.side != pos.WHITE;
    }
    var sq:    [8]i64;
    var file:  i64  = 0;
    var e:     *Enc = ?t.enc[0];
    var flags: i64  = 0;
    if (!t.has_pawns) {
        flags = d.flags[0]::i64;
        if (((flags & 1) != 0) != bside && !t.symmetric) {
            @other = true;
            ret 0;
        }
        var i: i64 = 0;
        for (i < t.num) { i = fill(p, e, flip, 0, ?sq[0], i); }
    }
    or {
        var mirror: i64 = 0;
        if (flip) { mirror = 0x38; }
        var i: i64 = fill(p, e, flip, mirror, ?sq[0], 0);
        var j: i64 = 1;
        for (j < t.pawns[0]) {
            if (FLAP[sq[0]] > FLAP[sq[j]]) { swap(?sq[0], 0, j); }
            j = j + 1;
        }
        file  = FILE_TO_FILE[sq[0] & 7]::i64;
        flags = d.flags[file]::i64;
        if (((flags & 1) != 0) != bside && !t.symmetric) {
            @other = true;
            ret 0;
        }
        e = ?t.enc[file];
        for (i < t.num) { i = fill(p, e, flip, mirror, ?sq[0], i); }
    }
    var v: i64 = decompress_dtz(t, ?e.pairs, encode(t, e, ?sq[0]));
    if ((flags & 2) != 0) {
        val m: i64 = WDL_TO_MAP[wdl + 2];
        if ((flags & 16) == 0) { v = t.bytes[d.map + d.map_idx[file][m] + v]::i64; }
        or                     { v = u16_le(t, d.map + 2 * (d.map_idx[file][m] + v)); }
    }
    if ((flags & PA_FLAGS[wdl + 2]) == 0 || (wdl & 1) != 0) { v = v * 2; }
    ret v;
}

fun is_mate(p: *Position) bool {
    if (!pos.in_check(p)) { ret false; }
    var list: MoveList;
    movegen.generate_legal(p, ?list);
    ret list.count == 0;
}

fun is_pawn_move(p: *Position, m: Move) bool {
    ret pos.kind_of(p.board[mv.from(m)]) == pos.PAWN;
}

# Fathom's probe_dtz: plies to the next capture or pawn move with best play, from the side to move. n > 0 wins
# (over 100: a win the fifty-move rule spoils), n < 0 loses, 0 draws, -1 for a mated position; may be one ply long
fun dtz_of(p: *Position, ok: *bool) i64 {
    var success: i64 = 0;
    val wdl:     i64 = wdl_full(p, ok, ?success);
    if (!@ok)         { ret 0; }
    if (wdl == 0)     { ret 0; }
    if (success == 2) { ret WDL_TO_DTZ[wdl + 2]; }
    var list: MoveList;
    movegen.generate_legal(p, ?list);
    if (wdl > 0) {
        # a winning pawn move that keeps the win zeroes the counter at once
        var i: i64 = 0;
        for (i < list.count) {
            val m: Move = list.moves[i];
            i = i + 1;
            if (!is_pawn_move(p, m) || is_capture(m)) { cnt; }
            pos.make(p, m);
            var s2: i64 = 0;
            val v:  i64 = 0 - wdl_full(p, ok, ?s2);
            pos.unmake(p);
            if (!@ok)     { ret 0; }
            if (v == wdl) { ret WDL_TO_DTZ[wdl + 2]; }
        }
    }
    var other: bool = false;
    val dtz:   i64  = probe_dtz_table(p, wdl, ok, ?other);
    if (!@ok) { ret 0; }
    if (!other) {
        if (wdl > 0) { ret WDL_TO_DTZ[wdl + 2] + dtz; }
        ret WDL_TO_DTZ[wdl + 2] - dtz;
    }
    # the table holds the other side to move: one ply of search over the moves that do not zero the counter
    var best: i64 = WDL_TO_DTZ[wdl + 2];
    if (wdl > 0) { best = 1000000; }
    var i: i64 = 0;
    for (i < list.count) {
        val m: Move = list.moves[i];
        i = i + 1;
        if (is_capture(m) || is_pawn_move(p, m)) { cnt; }
        pos.make(p, m);
        val v:    i64  = 0 - dtz_of(p, ok);
        val mate: bool = v == 1 && is_mate(p);
        pos.unmake(p);
        if (mate) {
            best = 1;
        }
        or (wdl > 0) {
            if (v > 0 && v + 1 < best) { best = v + 1; }
        }
        or {
            if (v - 1 < best) { best = v - 1; }
        }
        if (!@ok) { ret 0; }
    }
    ret best;
}

# the DTZ of the position for the side to move (see dtz_of); ok false when it is not in the tables
pub fun probe_dtz(p: *Position, ok: *bool) i64 {
    @ok = false;
    if (!probeable(p) || DTZ_TABLES == 0) { ret 0; }
    val accs: *nn.Acc = p.accs;
    p.accs = nil;
    val v: i64 = dtz_of(p, ok);
    p.accs = accs;
    if (!@ok) { ret 0; }
    ret v;
}

# whether a position has repeated since the counter was last zeroed: then a won ending must make progress, not merely
# keep the win (Fathom's hasRepeated)
fun has_repeated(p: *Position) bool {
    var n: i64 = p.halfmove;
    if (n > p.ply) { n = p.ply; }
    var i: i64 = 2;
    for (i <= n) {
        if (p.hist[p.ply - i].key == p.key) { ret true; }
        var j: i64 = i + 2;
        for (j <= n) {
            if (p.hist[p.ply - i].key == p.hist[p.ply - j].key) { ret true; }
            j = j + 2;
        }
        i = i + 2;
    }
    ret false;
}

# Fathom's root_probe_dtz, with the fifty-move rule: rank every legal move and give the root the moves of the best
# rank (out, up to 64 of them), so the search chooses only among moves that keep the best result and, in a won
# ending, keep it winnable inside the rule. false when the root is not in the tables.
pub fun root_moves(p: *Position, out: *Move, count: *i64) bool {
    @count = 0;
    if (!probeable(p) || DTZ_TABLES == 0) { ret false; }
    val accs: *nn.Acc = p.accs;
    p.accs = nil;
    var list: MoveList;
    movegen.generate_legal(p, ?list);
    val cnt50:    i64  = p.halfmove;
    val repeated: bool = has_repeated(p);
    var ranks:    [256]i64;
    var best:     i64  = -1000000;
    var ok:       bool = true;
    var i:        i64  = 0;
    for (i < list.count && ok) {
        val m: Move = list.moves[i];
        pos.make(p, m);
        var v: i64 = 0;
        if (p.halfmove == 0) {
            var s2: i64 = 0;
            v = 0 - wdl_full(p, ?ok, ?s2);
            if (ok) { v = WDL_TO_DTZ[v + 2]; }
        }
        or {
            v = 0 - dtz_of(p, ?ok);
            if (v > 0) { v = v + 1; }
            or (v < 0) { v = v - 1; }
        }
        if (v == 2 && is_mate(p)) { v = 1; }
        pos.unmake(p);
        var r: i64 = 0;
        if (v > 0) {
            if (v + cnt50 <= 99 && !repeated) { r = 1000; }
            or                                { r = 1000 - (v + cnt50); }
        }
        or (v < 0) {
            if (0 - v * 2 + cnt50 < 100) { r = -1000; }
            or                           { r = -1000 + (0 - v + cnt50); }
        }
        ranks[i] = r;
        if (r > best) { best = r; }
        i = i + 1;
    }
    p.accs = accs;
    if (!ok) { ret false; }
    i = 0;
    for (i < list.count && @count < 64) {
        if (ranks[i] == best) {
            out[@count] = list.moves[i];
            @count      = @count + 1;
        }
        i = i + 1;
    }
    ret @count > 0;
}
