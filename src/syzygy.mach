# Syzygy endgame tablebases: win, draw or loss for positions of up to five men, read in the search.
#
# The tables' format is Ronald de Man's. This is a Mach rewrite of the WDL half of the Fathom prober
# (github.com/jdart1/Fathom, MIT licence: Copyright (c) 2013-2018 Ronald de Man, (c) 2015 basil00, (c) 2016-2025 Jon
# Dart), held to python-chess's answers on the same files. Nothing here links C: the tables are read into memory with
# std.filesystem and decoded in Mach.
#
# A WDL table gives, for a position with no castling rights and no en passant square, the result with best play:
# 2 win, 1 win that the fifty-move rule turns into a draw, 0 draw, -1 the same loss, -2 loss, for the side to move.
# Positions whose best move is a capture are stored with whatever compresses best, so a probe first plays out the
# captures (probe_ab).
#
# The DTZ tables (.rtbz, the DTZ half of the same prober) say how many plies remain to the next capture or pawn move
# with best play, so a won ending can be won inside the fifty-move rule: probe_dtz gives it for any position of up to
# five men, and root_moves ranks the legal moves at the root as Fathom's root_probe_dtz does, so the search is held to
# the moves that keep the best result and make progress towards it.

use std.allocator;
use std.allocator.page;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

use fs:       std.filesystem;
use io_error: std.io.error;

use bb: machete.bitboard;
use mv: machete.move;
use machete.move.Move;
use machete.movegen;
use machete.movegen.MoveList;
use nn:  machete.nnue;
use pos: machete.position;
use machete.position.Position;

# the most men a loaded table has: 0 when no table is loaded, so the search never probes
pub var LARGEST: i64 = 0;

val MAX_TABLES:       i64 = 256;
val MAX_SYMBOLS_POOL: i64 = 16777216;

