# machete.tools.train: train machete's network, in Mach
#
#   train run    <out.nnue> <epochs> <batch> <lr> <threads> <scale> <blend> <validation> <seed> <corpus[@N]>...
#   train check  <corpus.bin> <init.flat> <out.flat> <steps> <batch> <lr> <threads> <scale> <blend>
#   train export <weights.flat> <out.nnue> <scale>
#
# the Mach counterpart of harness/nnue/train.py (see src/train.mach), and
# checked against it. `check` starts from the weights in init.flat, trains
# <steps> batches of <batch> positions taken from the front of the corpus in
# file order, prints each step's loss and writes the weights to out.flat;
# harness/nnue/trainer_check.py does the same in PyTorch and compares.
# `export` quantizes a weights file into the format the engine reads.
#
# `run` trains a network, as train.py does without --window: every record of
# every corpus (`path@N` takes the first N) is read into memory, --validation
# of them are held out, and each epoch visits the rest in a fresh random order
# in batches, at a learning rate that falls by 0.8 each epoch. After every
# epoch the network is written to <out.nnue>.partial with its validation loss;
# the last is renamed to <out.nnue>, so a job waiting for the file never starts
# on a network still training. Memory is 70 bytes a position plus 4 for the
# order: 20M positions is about 1.5 GB.
#
# A .flat file is the weights as little-endian f32: the feature weights
# (6144 x HIDDEN), their bias, the output weights (8 x 2 HIDDEN), their bias.

use std.print;
use std.runtime;
use std.text.parse;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.string.str_equals;

use A: std.allocator;
use std.allocator.page;
use fs:       std.filesystem;
use io_error: std.io.error;

use machete.clock;
use machete.rng;
use tr: machete.train;

val EXIT_USAGE: i64 = 1;
val EXIT_FAIL:  i64 = 2;

var RECORDS: [1146880]u8; # BATCH_CAP * 70

fun usage() i64 {
    print.eprintln("usage: train run    <out.nnue> <epochs> <batch> <lr> <threads> <scale> <blend> <validation> <seed> <corpus[@N]>...");
    print.eprintln("       train check  <corpus.bin> <init.flat> <out.flat> <steps> <batch> <lr> <threads> <scale> <blend>");
    print.eprintln("       train export <weights.flat> <out.nnue> <scale>");
    ret EXIT_USAGE;
}

fun read_exact(f: fs.File, buf: *u8, len: i64) bool {
    var at: i64 = 0;
    for (at < len) {
        val got: res[usize, io_error.Error] = fs.read(f, ?buf[at], (len - at)::usize);
        if (sel got.err)      { ret false; }
        if (got.ok::i64 == 0) { ret false; }
        at = at + got.ok::i64;
    }
    ret true;
}

fun write_all(f: fs.File, buf: *u8, len: i64) bool {
    var at: i64 = 0;
    for (at < len) {
        var chunk: i64 = len - at;
        if (chunk > 1073741824) { chunk = 1073741824; }
        val put: res[usize, io_error.Error] = fs.write(f, ?buf[at], chunk::usize);
        if (sel put.err)      { ret false; }
        if (put.ok::i64 == 0) { ret false; }
        at = at + put.ok::i64;
    }
    ret true;
}

fun load_flat(path: str) bool {
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret false; }
    var f:    fs.File = opened.ok;
    var ok:   bool    = true;
    var part: i64     = 0;
    for (part < 4) {
        if (!read_exact(f, tr.flat_ptr(part), tr.flat_len(part))) { ok = false; }
        part = part + 1;
    }
    val shut: err[io_error.Error] = fs.close(?f);
    ret ok;
}

fun save_flat(path: str) bool {
    val created: res[fs.File, io_error.Error] = fs.create(path, 420);
    if (sel created.err) { ret false; }
    var f:    fs.File = created.ok;
    var ok:   bool    = true;
    var part: i64     = 0;
    for (part < 4) {
        if (!write_all(f, tr.flat_ptr(part), tr.flat_len(part))) { ok = false; }
        part = part + 1;
    }
    val shut: err[io_error.Error] = fs.close(?f);
    ret ok;
}

fun int_arg(text: str, fallback: i64) i64 {
    val parsed: res[i64, parse.ParseError] = parse.parse_i64_exact(text, 10);
    if (sel parsed.err) { ret fallback; }
    ret parsed.ok;
}

# a decimal number with an optional fraction, e.g. 0.001 or 150 or 0.7
fun float_arg(text: str) f64 {
    var value: f64  = 0.0;
    var scale: f64  = 0.0;
    var i:     i64  = 0;
    var neg:   bool = false;
    if (text[0] == '-') {
        neg = true;
        i   = 1;
    }
    for (text[i] != 0) {
        val c: u8 = text[i];
        if (c == '.') {
            scale = 1.0;
        }
        or (c >= '0' && c <= '9') {
            if (scale > 0.0) {
                scale = scale / 10.0;
                value = value + ((c - '0')::f64) * scale;
            }
            or {
                value = value * 10.0 + (c - '0')::f64;
            }
        }
        i = i + 1;
    }
    if (neg) { ret 0.0 - value; }
    ret value;
}

fun check(argc: i64, argv: **u8) i64 {
    if (argc < 11) { ret usage(); }
    val steps:   i64 = int_arg(argv[5], 0);
    val batch:   i64 = int_arg(argv[6], 0);
    val lr:      f64 = float_arg(argv[7]);
    val threads: i64 = int_arg(argv[8], 1);
    tr.SCALE  = float_arg(argv[9]);
    tr.LAMBDA = float_arg(argv[10]);
    if (steps < 1 || batch < 1 || batch > tr.BATCH_CAP) { ret usage(); }
    if (!load_flat(argv[3])) {
        print.eprintlnf("cannot read {}", argv[3]);
        ret EXIT_FAIL;
    }
    val opened: res[fs.File, io_error.Error] = fs.open(argv[2]);
    if (sel opened.err) {
        print.eprintlnf("cannot open {}", argv[2]);
        ret EXIT_FAIL;
    }
    var f:    fs.File = opened.ok;
    var step: i64     = 1;
    for (step <= steps) {
        if (!read_exact(f, ?RECORDS[0], batch * tr.RECORD)) {
            print.eprintln("the corpus ran out");
            ret EXIT_FAIL;
        }
        var p: i64 = 0;
        for (p < batch) {
            tr.load_position(?RECORDS[p * tr.RECORD], p);
            p = p + 1;
        }
        val loss: f64 = tr.train_step(batch, threads, step, lr);
        print.printlnf("step {} loss {}", step, (loss * 1000000000.0)::i64);
        step = step + 1;
    }
    val shut: err[io_error.Error] = fs.close(?f);
    if (!save_flat(argv[4])) {
        print.eprintlnf("cannot write {}", argv[4]);
        ret EXIT_FAIL;
    }
    ret 0;
}

fun export(argc: i64, argv: **u8) i64 {
    if (argc < 5) { ret usage(); }
    if (!load_flat(argv[2])) {
        print.eprintlnf("cannot read {}", argv[2]);
        ret EXIT_FAIL;
    }
    val worst: i64 = tr.quantize();
    if (worst < 0 || worst > 32767) {
        print.eprintlnf("the network does not fit in int16 (worst accumulator {})", worst);
        ret EXIT_FAIL;
    }
    val created: res[fs.File, io_error.Error] = fs.create(argv[3], 420);
    if (sel created.err) {
        print.eprintlnf("cannot create {}", argv[3]);
        ret EXIT_FAIL;
    }
    var f:    fs.File = created.ok;
    var ok:   bool    = write_all(f, tr.header(int_arg(argv[4], 150)), 32);
    var part: i64     = 0;
    for (part < 4) {
        if (!write_all(f, tr.quantized_ptr(part), tr.quantized_len(part))) { ok = false; }
        part = part + 1;
    }
    val shut: err[io_error.Error] = fs.close(?f);
    if (!ok) { ret EXIT_FAIL; }
    print.printlnf("wrote {} (worst accumulator {} of 32767)", argv[3], worst);
    ret 0;
}

# ---- run ---------------------------------------------------------------

var HEAP:  A.Allocator;
var DATA:  *u8  = nil;
var ORDER: *u32 = nil;
var TOTAL: i64  = 0;
var PATH:  [1024]u8;

# `path@N`: the path into PATH and N (-1 for all of it)
fun split_spec(spec: str, take: *i64) {
    var i:  i64 = 0;
    var at: i64 = 0 - 1;
    for (spec[i] != 0 && i < 1023) {
        PATH[i] = spec[i];
        if (spec[i] == '@') { at = i; }
        i = i + 1;
    }
    PATH[i] = 0;
    @take   = 0 - 1;
    if (at >= 0) {
        PATH[at] = 0;
        @take    = int_arg(?spec[at + 1], 0 - 1);
    }
}

fun file_size(path: str) i64 {
    val opened: res[fs.File, io_error.Error] = fs.open(path);
    if (sel opened.err) { ret 0 - 1; }
    var f:    fs.File                  = opened.ok;
    val end:  res[i64, io_error.Error] = fs.seek(f, 0, fs.SEEK_END);
    val shut: err[io_error.Error]      = fs.close(?f);
    if (sel end.err) { ret 0 - 1; }
    ret end.ok;
}

# count, allocate and read every corpus; false with a message on failure
fun load_corpora(argc: i64, argv: **u8, first: i64) bool {
    var want: i64 = 0;
    var k:    i64 = first;
    for (k < argc) {
        var take: i64 = 0;
        split_spec(argv[k], ?take);
        val size: i64 = file_size(?PATH[0]);
        if (size < 0) {
            print.eprintlnf("cannot open {}", ?PATH[0]);
            ret false;
        }
        var rows: i64 = size / tr.RECORD;
        if (take >= 0 && take < rows) { rows = take; }
        want = want + rows;
        k    = k + 1;
    }
    val made: err[A.Error] = page.make(?HEAP);
    if (sel made.err) { ret false; }
    val data:  res[*u8, A.Error]  = A.allocate[u8](?HEAP, (want * tr.RECORD)::usize);
    val order: res[*u32, A.Error] = A.allocate[u32](?HEAP, want::usize);
    if (sel data.err) {
        print.eprintlnf("cannot allocate {} positions", want);
        ret false;
    }
    if (sel order.err) {
        print.eprintlnf("cannot allocate the order of {} positions", want);
        ret false;
    }
    DATA  = data.ok;
    ORDER = order.ok;
    TOTAL = 0;
    k     = first;
    for (k < argc) {
        var take: i64 = 0;
        split_spec(argv[k], ?take);
        var rows: i64 = file_size(?PATH[0]) / tr.RECORD;
        if (take >= 0 && take < rows) { rows = take; }
        val opened: res[fs.File, io_error.Error] = fs.open(?PATH[0]);
        if (sel opened.err) { ret false; }
        var f:    fs.File             = opened.ok;
        val ok:   bool                = read_exact(f, ?DATA[TOTAL * tr.RECORD], rows * tr.RECORD);
        val shut: err[io_error.Error] = fs.close(?f);
        if (!ok) {
            print.eprintlnf("cannot read {}", ?PATH[0]);
            ret false;
        }
        print.printlnf("  {} positions from {}", rows, ?PATH[0]);
        TOTAL = TOTAL + rows;
        k     = k + 1;
    }
    ret true;
}

# Fisher-Yates over ORDER[from, to)
fun shuffle(r: *rng.Rng, from: i64, to: i64) {
    var i: i64 = to - 1;
    for (i > from) {
        val j: i64 = from + (rng.below(r, (i - from + 1)::u64)::i64);
        val t: u32 = ORDER[i];
        ORDER[i] = ORDER[j];
        ORDER[j] = t;
        i        = i - 1;
    }
}

fun load_batch(from: i64, n: i64) {
    var p: i64 = 0;
    for (p < n) {
        tr.load_position(?DATA[(ORDER[from + p]::i64) * tr.RECORD], p);
        p = p + 1;
    }
}

fun write_network(path: str, scale: i64) i64 {
    val worst: i64 = tr.quantize();
    if (worst < 0 || worst > 32767) { ret 0 - 1; }
    val created: res[fs.File, io_error.Error] = fs.create(path, 420);
    if (sel created.err) { ret 0 - 1; }
    var f:    fs.File = created.ok;
    var ok:   bool    = write_all(f, tr.header(scale), 32);
    var part: i64     = 0;
    for (part < 4) {
        if (!write_all(f, tr.quantized_ptr(part), tr.quantized_len(part))) { ok = false; }
        part = part + 1;
    }
    val shut: err[io_error.Error] = fs.close(?f);
    if (!ok) { ret 0 - 1; }
    ret worst;
}

# thousandths, for printing a loss the way train.py's {:.5f} does
fun loss_text(x: f64) i64 {
    ret (x * 100000.0 + 0.5)::i64;
}

fun run(argc: i64, argv: **u8) i64 {
    if (argc < 11) { ret usage(); }
    val out:     str = argv[2];
    val epochs:  i64 = int_arg(argv[3], 0);
    val batch:   i64 = int_arg(argv[4], 0);
    val lr0:     f64 = float_arg(argv[5]);
    val threads: i64 = int_arg(argv[6], 1);
    val scale:   i64 = int_arg(argv[7], 150);
    tr.SCALE  = scale::f64;
    tr.LAMBDA = float_arg(argv[8]);
    val validation: i64 = int_arg(argv[9], 0);
    val seed:       i64 = int_arg(argv[10], 1);
    if (epochs < 1 || batch < 1 || batch > tr.BATCH_CAP || validation < 0) { ret usage(); }
    if (!load_corpora(argc, argv, 11))                                     { ret EXIT_FAIL; }
    if (TOTAL < validation * 4) {
        print.eprintln("not enough positions to hold out a validation set");
        ret EXIT_FAIL;
    }
    print.printlnf("{} positions, {} held out, training on {} threads", TOTAL, validation, threads);
    var i: i64 = 0;
    for (i < TOTAL) {
        ORDER[i] = i::u32;
        i        = i + 1;
    }
    var r: rng.Rng = rng.seeded(seed::u64);
    shuffle(?r, 0, TOTAL);
    tr.init_random((seed * 7919 + 1)::u64);

    # the partial file's name: out + ".partial"
    var partial: [1100]u8;
    i = 0;
    for (out[i] != 0 && i < 1000) {
        partial[i] = out[i];
        i          = i + 1;
    }
    val suffix: str = ".partial";
    var j:      i64 = 0;
    for (suffix[j] != 0) {
        partial[i + j] = suffix[j];
        j              = j + 1;
    }
    partial[i + j] = 0;

    var step:  i64 = 0;
    var lr:    f64 = lr0;
    var epoch: i64 = 1;
    for (epoch <= epochs) {
        shuffle(?r, validation, TOTAL);
        val started: i64 = clock.now_ms();
        var seen:    i64 = 0;
        var running: f64 = 0.0;
        var at:      i64 = validation;
        for (at + batch <= TOTAL) {
            load_batch(at, batch);
            step    = step + 1;
            running = running + tr.train_step(batch, threads, step, lr);
            seen    = seen + 1;
            at      = at + batch;
            if (seen % 100 == 0) {
                val ms: i64 = clock.now_ms() - started + 1;
                print.printlnf("epoch {}  {} positions  loss 0.{:05}  {}/s", epoch, seen * batch,
                    loss_text(running / (seen::f64)), seen * batch * 1000 / ms);
            }
        }
        # the held-out loss, in batches
        var error: f64 = 0.0;
        var count: i64 = 0;
        at = 0;
        for (at < validation) {
            var n: i64 = validation - at;
            if (n > batch) { n = batch; }
            load_batch(at, n);
            error = error + tr.evaluate(n, threads) * (n::f64);
            count = count + n;
            at    = at + n;
        }
        var val_loss: f64 = 0.0;
        if (count > 0) { val_loss = error / (count::f64); }
        var train_loss: f64 = 0.0;
        if (seen > 0) { train_loss = running / (seen::f64); }
        print.printlnf("epoch {} done: training loss 0.{:05}, validation 0.{:05}", epoch,
            loss_text(train_loss), loss_text(val_loss));
        val worst: i64 = write_network(?partial[0], scale);
        if (worst < 0) {
            print.eprintlnf("cannot write {}, or the network does not fit in int16", ?partial[0]);
            ret EXIT_FAIL;
        }
        print.printlnf("  wrote {} (worst accumulator {} of 32767)", ?partial[0], worst);
        lr    = lr * 0.8;
        epoch = epoch + 1;
    }
    val moved: err[io_error.Error] = fs.rename(?partial[0], out);
    if (sel moved.err) {
        print.eprintlnf("cannot rename {} to {}", ?partial[0], out);
        ret EXIT_FAIL;
    }
    print.printlnf("finished: {}", out);
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc < 2) { ret usage(); }
    val command: str = argv[1];
    if (str_equals(command, "run"))    { ret run(argc, argv); }
    if (str_equals(command, "check"))  { ret check(argc, argv); }
    if (str_equals(command, "export")) { ret export(argc, argv); }
    ret usage();
}
