# magic bitboards: sliding attacks by one multiply, shift and table read
#
# a rook on a square only cares about the occupancy of the squares it could be
# blocked on - its rays minus the board edges, at most 12 squares. those bits
# are gathered by masking, spread across the top of a 64-bit word by
# multiplying with a "magic" constant, and shifted down into an index.
#
# a magic is valid when no two occupancies that produce different attack sets
# land on the same index. collisions where the attack sets agree are fine and
# are what keeps the tables small. the constants are searched for at startup
# from a fixed seed, so every run builds the same tables, and a test checks
# every lookup against the ray-walking implementation it replaces.

use std.print;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use machete.attacks;
use bb: machete.bitboard;
use machete.rng;

# 102400 rook entries plus 5248 bishop entries, the standard sizes
pub val TABLE_SIZE: i64 = 107648;

var TABLE: [107648]u64;

var ROOK_MASK:   [64]u64;
var ROOK_MAGIC:  [64]u64;
var ROOK_SHIFT:  [64]u64;
var ROOK_OFFSET: [64]i64;

var BISHOP_MASK:   [64]u64;
var BISHOP_MAGIC:  [64]u64;
var BISHOP_SHIFT:  [64]u64;
var BISHOP_OFFSET: [64]i64;

