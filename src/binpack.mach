# machete.binpack: read Stockfish's binpack training-data format
#
# binpack is Tomasz Sobczyk's format (nnue-pytorch, data_loader/cpp/lib/
# binpack.h, MIT licence), in which Stockfish's networks are trained on Leela
# Chess Zero's self-play. this reads it with machete's own board: a game's
# first position arrives packed into 32 bytes, and every later move as an
# index among the moving side's pieces and then among that piece's
# destinations, so decoding a move needs exactly what move generation already
# computes.
#
#   file    chunks: "BINP", u32 size (little-endian), then that many bytes
#   chunk   games. each is a 32-byte stem - the first position, its move,
#           score, ply, result and fifty-move counter - then a big-endian u16
#           count of the moves that follow, then those moves bit-packed
#   score   stockfish internal units, 208 to a pawn, from the side to move
#   result  +1, 0, -1 from the side to move
#
# a move index means something only against the exact destination set the
# writer computed, so one misread bit desynchronises everything after it.
# every decoded move is therefore looked up in the legal move list - which
# also gives it machete's flags for captures, castling and en passant - and a
# move that is not there stops the decode. scores are not self-checking: a
# flipped bit inside a score changes that score and nothing else.
#
# harness/nnue/leela.py is the reference; tools/binpack.mach must reproduce
# its records byte for byte.

use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;

use machete.attacks;
use bb: machete.bitboard;
use machete.magic;
use mv: machete.move;
use machete.move.Move;
use gen: machete.movegen;
use machete.movegen.MoveList;
use pos: machete.position;
use machete.position.Position;

pub val STEM:             i64 = 32;
pub val RECORD_SIZE:      i64 = 70;
pub val ENGINE_ID:        u8  = 11; # our records' teacher id: 10 theoden, 11 Leela
pub val CLAMP:            f64 = 10000.0;
val     INTERNAL_PAWN:    f64 = 208.0; # stockfish internal units per pawn, as binpack.h converts
val     MAX_SCALE_POINTS: i64 = 64;

# what went wrong when a chunk does not decode; zero is success
pub val OK:           i64 = 0;
pub val BAD_STEM:     i64 = 1; # the stem's own move is not legal in its position
pub val BAD_MOVE:     i64 = 2; # a move-text move is not legal: the bits are out of step
pub val OVERRUN:      i64 = 3; # the move text runs past the end of the chunk
pub val NOT_CONSUMED: i64 = 4; # the chunk has bytes left that no game accounts for
pub val STOPPED:      i64 = 5; # the visitor asked to stop

# one position handed to a visitor: the board before the move, the move played
# from it, the score from the side to move in internal units, and the result
# (+1, 0, -1) from the side to move. a nonzero return stops the decode.
pub def Visit: fun(ptr, *Position, Move, i64, i64) i64;

# a cursor into move text, reading bits from the top of each byte
# ---
# data:    the chunk
# size:    its length in bytes; reading past it sets overrun
# offset:  the byte being read
# left:    bits still unread in that byte
# overrun: set when a read would pass the end of the chunk
pub rec Bits {
    data:    *u8;
    size:    i64;
    offset:  i64;
    left:    i64;
    overrun: bool;
}

# unsigned_to_signed: binpack.h's zigzag-like decoding of a stored u16
pub fun unsigned_to_signed(value: i64) i64 {
    var r: i64 = ((value << 15) | (value >> 1)) & 0xFFFF;
    if ((r & 0x8000) != 0) { r = r ^ 0x7FFF; }
    if ((r & 0x8000) != 0) { ret r - 0x10000; }
    ret r;
}

# int16: wrap to a signed 16-bit value, as the C++ int16_t arithmetic does
pub fun int16(x: i64) i64 {
    ret ((x + 0x8000) & 0xFFFF) - 0x8000;
}

# used_bits_safe: bits needed to store an index below value
pub fun used_bits_safe(value: i64) i64 {
    if (value <= 1) { ret 0; }
    ret bb.msb((value - 1)::u64) + 1;
}

# nth_set: the square of the nth set bit, lowest first, or -1 when there is none
pub fun nth_set(bits: u64, n: i64) i64 {
    var b: u64 = bits;
    var i: i64 = 0;
    for (i < n) {
        b = b & (b - 1);
        i = i + 1;
    }
    if (b == 0) { ret -1; }
    ret bb.lsb(b);
}

fun byte_at(b: *Bits, at: i64) i64 {
    if (at >= b.size) {
        b.overrun = true;
        ret 0;
    }
    ret b.data[at]::i64;
}

# take: the next count bits (count at most 8), most significant first
pub fun take(b: *Bits, count: i64) i64 {
    if (count == 0) { ret 0; }
    if (b.left == 0) {
        b.offset = b.offset + 1;
        b.left   = 8;
    }
    val byte: i64 = (byte_at(b, b.offset) << (8 - b.left)) & 0xFF;
    var bits: i64 = byte >> (8 - count);
    if (count > b.left) {
        val spill: i64 = count - b.left;
        bits     = bits | (byte_at(b, b.offset + 1) >> (8 - spill));
        b.left   = b.left + 8;
        b.offset = b.offset + 1;
    }
    b.left = b.left - count;
    ret bits;
}

# vle16: a variable-length value in blocks of four bits, a fifth bit saying more follows
pub fun vle16(b: *Bits) i64 {
    var value: i64 = 0;
    var shift: i64 = 0;
    for (true) {
        val part: i64 = take(b, 5);
        value = value | ((part & 15) << shift);
        if ((part >> 4) == 0) { brk; }
        shift = shift + 4;
    }
    ret value & 0xFFFF;
}

# bits_end: the first byte after the move text
pub fun bits_end(b: *Bits) i64 {
    if (b.left != 8) { ret b.offset + 1; }
    ret b.offset;
}

# the legal move from `from` to `to` (promoting to `promo`, 0 for none), or mv.NONE
fun resolve(list: *MoveList, from: i64, to: i64, promo: u8) Move {
    var i: i64 = 0;
    for (i < list.count) {
        val m: Move = list.moves[i];
        if (mv.from(m) == from && mv.to(m) == to) {
            if (promo == 0 && !mv.is_promotion(m))                                 { ret m; }
            if (promo != 0 && mv.is_promotion(m) && mv.promotion_type(m) == promo) { ret m; }
        }
        i = i + 1;
    }
    ret mv.NONE;
}

# whether an en passant capture is legal here - the only case binpack records
# an en passant square, where machete keeps one after every double push
fun en_passant_legal(list: *MoveList) bool {
    var i: i64 = 0;
    for (i < list.count) {
        if (mv.flag(list.moves[i]) == mv.EP_CAPTURE) { ret true; }
        i = i + 1;
    }
    ret false;
}

fun piece_attacks(kind: u8, sq: i64, occ: u64) u64 {
    if (kind == pos.KNIGHT) { ret attacks.KNIGHT[sq]; }
    if (kind == pos.BISHOP) { ret magic.bishop(sq, occ); }
    if (kind == pos.ROOK)   { ret magic.rook(sq, occ); }
    ret magic.queen(sq, occ);
}

# binpack.h's nextMoveScore, less the score: which piece, then where it went
fun next_move(p: *Position, b: *Bits, list: *MoveList) Move {
    val us:       u8  = p.side;
    val ours:     u64 = p.occ[us];
    val theirs:   u64 = p.occ[us ^ 1];
    val occupied: u64 = ours | theirs;
    val from:     i64 = nth_set(ours, take(b, used_bits_safe(bb.count(ours))));
    if (from < 0) { ret mv.NONE; }
    val kind: u8 = pos.kind_of(p.board[from]);

    if (kind == pos.PAWN) {
        var forward:    i64 = 8;
        var start_rank: i64 = 1;
        var last_rank:  i64 = 6;
        if (us == pos.BLACK) {
            forward    = -8;
            start_rank = 6;
            last_rank  = 1;
        }
        var targets: u64 = theirs;
        if (p.ep != pos.NO_SQ && en_passant_legal(list)) { targets = targets | bb.bit(p.ep); }
        var destinations: u64 = attacks.PAWN[us][from] & targets;
        val ahead:        i64 = from + forward;
        if ((occupied & bb.bit(ahead)) == 0) {
            destinations = destinations | bb.bit(ahead);
            if (bb.rank_of(from) == start_rank && (occupied & bb.bit(ahead + forward)) == 0) {
                destinations = destinations | bb.bit(ahead + forward);
            }
        }
        val count: i64 = bb.count(destinations);
        if (bb.rank_of(from) == last_rank) {
            val index: i64 = take(b, used_bits_safe(count * 4));
            ret resolve(list, from, nth_set(destinations, index / 4), ((index % 4) + 1)::u8);
        }
        ret resolve(list, from, nth_set(destinations, take(b, used_bits_safe(count))), 0);
    }

    if (kind == pos.KING) {
        var rights:     u8 = p.castling & (pos.CASTLE_WK | pos.CASTLE_WQ);
        var queen_side: u8 = pos.CASTLE_WQ;
        if (us == pos.BLACK) {
            rights     = p.castling & (pos.CASTLE_BK | pos.CASTLE_BQ);
            queen_side = pos.CASTLE_BQ;
        }
        val reach: u64 = attacks.KING[from] & ~ours;
        val size:  i64 = bb.count(reach);
        val index: i64 = take(b, used_bits_safe(size + bb.count(rights::u64)));
        if (index >= size) {
            # castling: the first extra index is queen-side when that right exists
            if (index == size && (rights & queen_side) != 0) { ret resolve(list, from, from - 2, 0); }
            ret resolve(list, from, from + 2, 0);
        }
        ret resolve(list, from, nth_set(reach, index), 0);
    }

    val reach: u64 = piece_attacks(kind, from, occupied) & ~ours;
    ret resolve(list, from, nth_set(reach, take(b, used_bits_safe(bb.count(reach)))), 0);
}

fun fen_char(nibble: i64) u8 {
    val kinds: *u8 = "pnbrqk";
    var c:     u8  = kinds[nibble >> 1];
    if ((nibble & 1) == 0) { c = c - 32; } # white: upper case
    ret c;
}

fun put_char(out: *u8, at: *i64, c: u8) {
    out[@at] = c;
    @at      = @at + 1;
}

fun put_number(out: *u8, at: *i64, value: i64) {
    var digits: [20]u8;
    var n:      i64 = 0;
    var v:      i64 = value;
    if (v == 0) {
        digits[0] = '0';
        n         = 1;
    }
    for (v > 0) {
        digits[n] = ('0'::i64 + v % 10)::u8;
        v         = v / 10;
        n         = n + 1;
    }
    for (n > 0) {
        n = n - 1;
        put_char(out, at, digits[n]);
    }
}

# read_stem: set p to a game's first position and return the move played from it
# ---
# stem:   the 32 packed bytes
# p:      the position to set
# score:  receives the score, in internal units, from the side to move
# result: receives the result, +1/0/-1, from the side to move
# ret:    the move, or mv.NONE when it is not legal - which fails the chunk
pub fun read_stem(stem: *u8, p: *Position, score: *i64, result: *i64) Move {
    var squares: [64]i64;
    var i:       i64 = 0;
    for (i < 64) {
        squares[i] = -1;
        i          = i + 1;
    }
    var occupied: u64 = 0;
    i = 0;
    for (i < 8) {
        occupied = (occupied << 8) | stem[i]::u64;
        i        = i + 1;
    }
    var castling: [5]u8;
    var rights:   i64  = 0;
    var black:    bool = false;
    var ep:       i64  = -1;
    var index:    i64  = 0;
    var left:     u64  = occupied;
    for (left != 0) {
        val sq: i64 = bb.lsb(left);
        left = left & (left - 1);
        val nibble: i64 = (stem[8 + index / 2]::i64 >> (4 * (index % 2))) & 15;
        index = index + 1;
        if (nibble < 12) {
            squares[sq] = nibble;
        }
        or (nibble == 12) {
            # a pawn that has just moved two squares, with an en passant square behind it
            if (bb.rank_of(sq) == 3) {
                squares[sq] = 0;
                ep          = sq - 8;
            }
            or {
                squares[sq] = 1;
                ep          = sq + 8;
            }
        }
        or (nibble == 13) {
            squares[sq] = 6;
            if (sq == 0) { castling[1] = 'Q'; }
            or           { castling[0] = 'K'; }
            rights = rights + 1;
        }
        or (nibble == 14) {
            squares[sq] = 7;
            if (sq == 56) { castling[3] = 'q'; }
            or            { castling[2] = 'k'; }
            rights = rights + 1;
        }
        or {
            squares[sq] = 11;
            black       = true;
        }
    }

    # the stem as FEN, so the position is built by machete's own tested parser
    var fen:  [128]u8;
    var at:   i64 = 0;
    var rank: i64 = 7;
    for (rank >= 0) {
        var empty: i64 = 0;
        var file:  i64 = 0;
        for (file < 8) {
            val nibble: i64 = squares[rank * 8 + file];
            if (nibble < 0) {
                empty = empty + 1;
            }
            or {
                if (empty > 0) { put_number(?fen[0], ?at, empty); }
                empty = 0;
                put_char(?fen[0], ?at, fen_char(nibble));
            }
            file = file + 1;
        }
        if (empty > 0) { put_number(?fen[0], ?at, empty); }
        if (rank > 0)  { put_char(?fen[0], ?at, '/'); }
        rank = rank - 1;
    }
    put_char(?fen[0], ?at, ' ');
    if (black) { put_char(?fen[0], ?at, 'b'); }
    or         { put_char(?fen[0], ?at, 'w'); }
    put_char(?fen[0], ?at, ' ');
    if (rights == 0) {
        put_char(?fen[0], ?at, '-');
    }
    or {
        i = 0;
        for (i < 4) {
            if (castling[i] != 0) { put_char(?fen[0], ?at, castling[i]); }
            i = i + 1;
        }
    }
    put_char(?fen[0], ?at, ' ');
    if (ep < 0) {
        put_char(?fen[0], ?at, '-');
    }
    or {
        put_char(?fen[0], ?at, ('a'::i64 + bb.file_of(ep))::u8);
        put_char(?fen[0], ?at, ('1'::i64 + bb.rank_of(ep))::u8);
    }
    val ply_result: i64 = (stem[28]::i64 << 8) | stem[29]::i64;
    put_char(?fen[0], ?at, ' ');
    put_number(?fen[0], ?at, (stem[30]::i64 << 8) | stem[31]::i64);
    put_char(?fen[0], ?at, ' ');
    put_number(?fen[0], ?at, (ply_result & 0x3FFF) / 2 + 1);
    fen[at] = 0;
    if (!pos.set_fen(p, ?fen[0])) { ret mv.NONE; }

    @score  = unsigned_to_signed((stem[26]::i64 << 8) | stem[27]::i64);
    @result = unsigned_to_signed(ply_result >> 14);

    val packed: i64 = (stem[24]::i64 << 8) | stem[25]::i64;
    val kind:   i64 = packed >> 14;
    val from:   i64 = (packed >> 8) & 63;
    var to:     i64 = (packed >> 2) & 63;
    var promo:  u8  = 0;
    if (kind == 1) { promo = ((packed & 3) + 1)::u8; }
    if (kind == 2) {
        # binpack castles as king-takes-own-rook; machete moves the king two files
        if (bb.file_of(to) == 7) { to = from + 2; }
        or                       { to = from - 2; }
    }
    var list: MoveList;
    gen.generate_legal(p, ?list);
    ret resolve(?list, from, to, promo);
}

# decode_chunk: every position in one chunk, handed to visit in order
# ---
# data:  the chunk's bytes, after its 8-byte header
# size:  their number
# p:     scratch position; its history is dropped after every move, since a
#        game can outrun the 1,024-ply history and nothing is taken back
# visit: called once per position
# ctx:   passed through to visit
# ret:   OK, or the reason the chunk failed
pub fun decode_chunk(data: *u8, size: i64, p: *Position, visit: Visit, ctx: ptr) i64 {
    var offset: i64 = 0;
    for (offset + STEM + 2 <= size) {
        var score:  i64  = 0;
        var result: i64  = 0;
        var move:   Move = read_stem(?data[offset], p, ?score, ?result);
        if (move == mv.NONE) { ret BAD_STEM; }
        offset = offset + STEM;
        val plies: i64 = (data[offset]::i64 << 8) | data[offset + 1]::i64;
        offset = offset + 2;
        if (visit(ctx, p, move, score, result) != 0) { ret STOPPED; }
        if (plies > 0) {
            var bits: Bits = Bits{data: data, size: size, offset: offset, left: 8, overrun: false};
            var last: i64  = int16(0 - score);
            var k:    i64  = 0;
            for (k < plies) {
                pos.make(p, move);
                p.ply  = 0;
                result = 0 - result;
                var list: MoveList;
                gen.generate_legal(p, ?list);
                move = next_move(p, ?bits, ?list);
                if (bits.overrun)    { ret OVERRUN; }
                if (move == mv.NONE) { ret BAD_MOVE; }
                score = int16(last + unsigned_to_signed(vle16(?bits)));
                if (bits.overrun) { ret OVERRUN; }
                last = int16(0 - score);
                if (visit(ctx, p, move, score, result) != 0) { ret STOPPED; }
                k = k + 1;
            }
            offset = bits_end(?bits);
        }
    }
    if (offset != size) { ret NOT_CONSUMED; }
    ret OK;
}

# the leela-to-teacher score table (harness/nnue/leela_scale.json)
# ---
# xs: Leela's centipawns, ascending; ys: our teachers' median at each
pub rec Scale {
    xs: [64]f64;
    ys: [64]f64;
    n:  i64;
}

# scale_add: append a point to the table; false when it is full
pub fun scale_add(s: *Scale, x: f64, y: f64) bool {
    if (s.n >= MAX_SCALE_POINTS) { ret false; }
    s.xs[s.n] = x;
    s.ys[s.n] = y;
    s.n       = s.n + 1;
    ret true;
}

# numpy.interp, as numpy computes it: the same branches, the same operation order
fun interp(s: *Scale, x: f64) f64 {
    if (x <= s.xs[0])       { ret s.ys[0]; }
    if (x >= s.xs[s.n - 1]) { ret s.ys[s.n - 1]; }
    var j: i64 = 0;
    for (j + 1 < s.n && s.xs[j + 1] <= x) { j = j + 1; }
    if (s.xs[j] == x) { ret s.ys[j]; }
    val slope: f64 = (s.ys[j + 1] - s.ys[j]) / (s.xs[j + 1] - s.xs[j]);
    ret slope * (x - s.xs[j]) + s.ys[j];
}

# python's round(): to the nearest integer, halves to the even neighbour
pub fun round_even(y: f64) i64 {
    var f: i64 = y::i64;
    if (y < 0.0 && f::f64 != y) { f = f - 1; }
    val frac: f64 = y - f::f64;
    if (frac > 0.5)                  { ret f + 1; }
    if (frac == 0.5 && (f % 2) != 0) { ret f + 1; }
    ret f;
}

# mapped: a Leela score as our teachers would give it, in whole centipawns
pub fun mapped(s: *Scale, score: i64) i64 {
    var cp: f64 = score::f64 * 100.0 / INTERNAL_PAWN;
    if (cp > CLAMP)       { cp = CLAMP; }
    if (cp < 0.0 - CLAMP) { cp = 0.0 - CLAMP; }
    if (cp > 0.0)         { ret round_even(interp(s, cp)); }
    if (cp < 0.0)         { ret round_even(0.0 - interp(s, 0.0 - cp)); }
    ret 0;
}

# write_record: one position as a training record (harness/nnue/reference.py RECORD)
# ---
# p:      the position
# score:  the label, in centipawns from the side to move
# result: +1/0/-1 from the side to move
# out:    RECORD_SIZE bytes to fill
pub fun write_record(p: *Position, score: i64, result: i64, out: *u8) {
    var i: i64 = 0;
    for (i < RECORD_SIZE) {
        out[i] = 0;
        i      = i + 1;
    }
    out[0] = p.side;
    # pieces from the highest square down, the order python-chess's piece_map gives
    var slot: i64 = 0;
    var sq:   i64 = 63;
    for (sq >= 0) {
        val pc: u8 = p.board[sq];
        if (pc != pos.EMPTY) {
            out[2 + slot]  = pc;
            out[34 + slot] = sq::u8;
            slot           = slot + 1;
        }
        sq = sq - 1;
    }
    out[1] = slot::u8;
    val stored: i64 = score & 0xFFFF;
    out[66] = (stored & 0xFF)::u8;
    out[67] = (stored >> 8)::u8;
    out[68] = (result + 1)::u8;
    out[69] = ENGINE_ID;
}

test "binpack: stored values decode as binpack.h does" {
    if (unsigned_to_signed(0) != 0)                                                        { ret 1; }
    if (unsigned_to_signed(1) != -1)                                                       { ret 2; }
    if (unsigned_to_signed(2) != 1)                                                        { ret 3; }
    if (int16(32768) != -32768 || int16(-32769) != 32767)                                  { ret 4; }
    if (used_bits_safe(0) != 0 || used_bits_safe(1) != 0 || used_bits_safe(2) != 1)        { ret 5; }
    if (used_bits_safe(8) != 3 || used_bits_safe(9) != 4)                                  { ret 6; }
    if (nth_set(0b10110, 0) != 1 || nth_set(0b10110, 2) != 4 || nth_set(0b10110, 3) != -1) { ret 7; }
    ret 0;
}

test "binpack: bits come off the top of each byte, across byte edges" {
    var data: [2]u8 = [2]u8{0b10110011, 0b01000000};
    var b:    Bits  = Bits{data: ?data[0], size: 2, offset: 0, left: 8, overrun: false};
    if (take(?b, 3) != 0b101)     { ret 1; }
    if (take(?b, 7) != 0b1001101) { ret 2; }
    if (take(?b, 1) != 0)         { ret 3; }
    if (b.overrun)                { ret 4; }
    if (take(?b, 8) != 0)         { ret 5; }
    if (!b.overrun)               { ret 6; }
    ret 0;
}

test "binpack: rounding matches python's round" {
    if (round_even(2.5) != 2 || round_even(3.5) != 4)      { ret 1; }
    if (round_even(-2.5) != -2 || round_even(-3.5) != -4)  { ret 2; }
    if (round_even(2.4999) != 2 || round_even(-0.6) != -1) { ret 3; }
    ret 0;
}
