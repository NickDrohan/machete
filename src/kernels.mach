            vpsubw ymm2, ymm2, [r8 + 192]
            vmovdqu [rdx + 192], ymm2
            vmovdqu ymm3, [rcx + 224]
            vpaddw ymm3, ymm3, [rax + 224]
            vpsubw ymm3, ymm3, [r8 + 224]
            vmovdqu [rdx + 224], ymm3
            vmovdqu ymm0, [rcx + 256]
            vpaddw ymm0, ymm0, [rax + 256]
