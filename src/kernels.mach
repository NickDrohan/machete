# subtract one weight column: into -= row, 1024 lanes
pub fun sub_column_avx2(into: *i16, row: *i16) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64,avx2 {
            mov rdx, {into}
            mov rcx, {row}
            vmovdqu ymm0, [rdx]
            vpsubw ymm0, ymm0, [rcx]
            vmovdqu [rdx], ymm0
            vmovdqu ymm1, [rdx + 32]
            vpsubw ymm1, ymm1, [rcx + 32]
            vmovdqu [rdx + 32], ymm1
            vmovdqu ymm2, [rdx + 64]
            vpsubw ymm2, ymm2, [rcx + 64]
            vmovdqu [rdx + 64], ymm2
            vmovdqu ymm3, [rdx + 96]
            vpsubw ymm3, ymm3, [rcx + 96]
            vmovdqu [rdx + 96], ymm3
            vmovdqu ymm0, [rdx + 128]
            vpsubw ymm0, ymm0, [rcx + 128]
            vmovdqu [rdx + 128], ymm0
            vmovdqu ymm1, [rdx + 160]
            vpsubw ymm1, ymm1, [rcx + 160]
            vmovdqu [rdx + 160], ymm1
            vmovdqu ymm2, [rdx + 192]
            vpsubw ymm2, ymm2, [rcx + 192]
            vmovdqu [rdx + 192], ymm2
            vmovdqu ymm3, [rdx + 224]
            vpsubw ymm3, ymm3, [rcx + 224]
            vmovdqu [rdx + 224], ymm3
            vmovdqu ymm0, [rdx + 256]
            vpsubw ymm0, ymm0, [rcx + 256]
            vmovdqu [rdx + 256], ymm0
            vmovdqu ymm1, [rdx + 288]
            vpsubw ymm1, ymm1, [rcx + 288]
            vmovdqu [rdx + 288], ymm1
            vmovdqu ymm2, [rdx + 320]
            vpsubw ymm2, ymm2, [rcx + 320]
            vmovdqu [rdx + 320], ymm2
            vmovdqu ymm3, [rdx + 352]
            vpsubw ymm3, ymm3, [rcx + 352]
            vmovdqu [rdx + 352], ymm3
            vmovdqu ymm0, [rdx + 384]
            vpsubw ymm0, ymm0, [rcx + 384]
            vmovdqu [rdx + 384], ymm0
            vmovdqu ymm1, [rdx + 416]
            vpsubw ymm1, ymm1, [rcx + 416]
