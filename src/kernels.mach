# copy a half: to = from, 1024 lanes
pub fun copy_half_avx2(to: *i16, from: *i16) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64,avx2 {
            mov rdx, {to}
            mov rcx, {from}
            vmovdqu ymm0, [rcx]
            vmovdqu [rdx], ymm0
            vmovdqu ymm1, [rcx + 32]
            vmovdqu [rdx + 32], ymm1
            vmovdqu ymm2, [rcx + 64]
            vmovdqu [rdx + 64], ymm2
            vmovdqu ymm3, [rcx + 96]
            vmovdqu [rdx + 96], ymm3
            vmovdqu ymm0, [rcx + 128]
            vmovdqu [rdx + 128], ymm0
