            vpsubw ymm2, ymm2, [r9 + 1984]
            vmovdqu [rdx + 1984], ymm2
            vmovdqu ymm3, [rcx + 2016]
            vpaddw ymm3, ymm3, [rax + 2016]
            vpsubw ymm3, ymm3, [r8 + 2016]
            vpsubw ymm3, ymm3, [r9 + 2016]
            vmovdqu [rdx + 2016], ymm3
            vzeroupper
        }
    }
}
