            mov r8, {px}
            xor ecx, ecx
            # xgetbv
            .byte 0x0F, 0x01, 0xD0 :: writes(rax, rdx)
            mov [r8], rax
        }
        ret ((leaf7 >> 5) & 1) == 1 && (xcr0 & 6) == 6;
    }
    $or {
        ret false;
    }
}

