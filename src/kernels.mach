# the output layer's half on AVX2, 16 lanes a step, same sums as SSE2
pub fun accumulate_avx2(values: *i16, weights: *i16, out: *i32) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rdx, {values}
            mov rcx, {weights}
            mov rax, {out}
            # ymm4 = 0, ymm3 = QA (255) in every lane, ymm2 and ymm5 = the sums
            .byte 0xC5, 0xDD, 0xEF, 0xE4 :: writes(xmm4)
            .byte 0xC5, 0xE5, 0x75, 0xDB :: writes(xmm3)
            .byte 0xC5, 0xE5, 0x71, 0xD3, 0x08 :: writes(xmm3)
            .byte 0xC5, 0xED, 0xEF, 0xD2 :: writes(xmm2)
            .byte 0xC5, 0xD5, 0xEF, 0xED :: writes(xmm5)
            # lanes 0..15
            .byte 0xC5, 0xFE, 0x6F, 0x82, 0x00, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0xC5, 0xFD, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0xC5, 0xFD, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xC5, 0xFD, 0xF5, 0x81, 0x00, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0xC5, 0xED, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 16..31
            .byte 0xC5, 0xFE, 0x6F, 0x8A, 0x20, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0xC5, 0xF5, 0xEE, 0xCC :: writes(xmm1)
            .byte 0xC5, 0xF5, 0xEA, 0xCB :: writes(xmm1)
            .byte 0xC5, 0xF5, 0xF5, 0x89, 0x20, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0xC5, 0xD5, 0xFE, 0xE9 :: writes(xmm5)
            # lanes 32..47
            .byte 0xC5, 0xFE, 0x6F, 0x82, 0x40, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0xC5, 0xFD, 0xEE, 0xC4 :: writes(xmm0)
            .byte 0xC5, 0xFD, 0xEA, 0xC3 :: writes(xmm0)
            .byte 0xC5, 0xFD, 0xF5, 0x81, 0x40, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0xC5, 0xED, 0xFE, 0xD0 :: writes(xmm2)
            # lanes 48..63
            .byte 0xC5, 0xFE, 0x6F, 0x8A, 0x60, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0xC5, 0xF5, 0xEE, 0xCC :: writes(xmm1)
            .byte 0xC5, 0xF5, 0xEA, 0xCB :: writes(xmm1)
            .byte 0xC5, 0xF5, 0xF5, 0x89, 0x60, 0x00, 0x00, 0x00 :: writes(xmm1)
            .byte 0xC5, 0xD5, 0xFE, 0xE9 :: writes(xmm5)
            # lanes 64..79
