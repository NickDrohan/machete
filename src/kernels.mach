# a child's half in one pass: to = from + add - sub, 1024 lanes
pub fun carry_add_sub_avx2(to: *i16, from: *i16, add: *i16, sub: *i16) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64,avx2 {
            mov rdx, {to}
            mov rcx, {from}
            mov rax, {add}
            mov r8, {sub}
            vmovdqu ymm0, [rcx]
            vpaddw ymm0, ymm0, [rax]
            vpsubw ymm0, ymm0, [r8]
            vmovdqu [rdx], ymm0
            vmovdqu ymm1, [rcx + 32]
            vpaddw ymm1, ymm1, [rax + 32]
            vpsubw ymm1, ymm1, [r8 + 32]
            vmovdqu [rdx + 32], ymm1
            vmovdqu ymm2, [rcx + 64]
            vpaddw ymm2, ymm2, [rax + 64]
            vpsubw ymm2, ymm2, [r8 + 64]
            vmovdqu [rdx + 64], ymm2
            vmovdqu ymm3, [rcx + 96]
            vpaddw ymm3, ymm3, [rax + 96]
            vpsubw ymm3, ymm3, [r8 + 96]
            vmovdqu [rdx + 96], ymm3
            vmovdqu ymm0, [rcx + 128]
            vpaddw ymm0, ymm0, [rax + 128]
            vpsubw ymm0, ymm0, [r8 + 128]
            vmovdqu [rdx + 128], ymm0
            vmovdqu ymm1, [rcx + 160]
