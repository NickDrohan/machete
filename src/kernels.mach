            vpaddd ymm5, ymm5, ymm1
            # ymm2 += ymm5, fold the high 128 bits onto the low, store four sums
            vpaddd ymm2, ymm2, ymm5
            vextracti128 xmm1, ymm2, 1
            vpaddd xmm2, xmm2, xmm1
            vmovdqu [rax], xmm2
            vzeroupper
        }
    }
}

# the output layer's half for SCReLU on AVX2: clamp, square, shift by 8, multiply-add
pub fun accumulate_screlu_avx2(values: *i16, weights: *i16, out: *i32) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86-64,avx2 {
            mov rdx, {values}
            mov rcx, {weights}
            mov rax, {out}
            # ymm4 = 0, ymm3 = QA (255) in every lane, ymm2 and ymm5 = the sums
            vpxor ymm4, ymm4, ymm4
            vpcmpeqw ymm3, ymm3, ymm3
            vpsrlw ymm3, ymm3, 8
            vpxor ymm2, ymm2, ymm2
            vpxor ymm5, ymm5, ymm5
            # lanes 0..15
            vmovdqu ymm0, [rdx]
            vpmaxsw ymm0, ymm0, ymm4
            vpminsw ymm0, ymm0, ymm3
            vpmullw ymm0, ymm0, ymm0
            vpsrlw ymm0, ymm0, 8
            vpmaddwd ymm0, ymm0, [rcx]
            vpaddd ymm2, ymm2, ymm0
            # lanes 16..31
            vmovdqu ymm1, [rdx + 32]
            vpmaxsw ymm1, ymm1, ymm4
            vpminsw ymm1, ymm1, ymm3
            vpmullw ymm1, ymm1, ymm1
            vpsrlw ymm1, ymm1, 8
            vpmaddwd ymm1, ymm1, [rcx + 32]
            vpaddd ymm5, ymm5, ymm1
            # lanes 32..47
            vmovdqu ymm0, [rdx + 64]
            vpmaxsw ymm0, ymm0, ymm4
            vpminsw ymm0, ymm0, ymm3
            vpmullw ymm0, ymm0, ymm0
            vpsrlw ymm0, ymm0, 8
            vpmaddwd ymm0, ymm0, [rcx + 64]
            vpaddd ymm2, ymm2, ymm0
            # lanes 48..63
            vmovdqu ymm1, [rdx + 96]
            vpmaxsw ymm1, ymm1, ymm4
            vpminsw ymm1, ymm1, ymm3
            vpmullw ymm1, ymm1, ymm1
            vpsrlw ymm1, ymm1, 8
            vpmaddwd ymm1, ymm1, [rcx + 96]
            vpaddd ymm5, ymm5, ymm1
