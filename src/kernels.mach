            vmovdqu [rdx + 448], ymm2
            vmovdqu ymm3, [rcx + 480]
            vmovdqu [rdx + 480], ymm3
            vmovdqu ymm0, [rcx + 512]
            vmovdqu [rdx + 512], ymm0
