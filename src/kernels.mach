# whether this CPU runs AVX2 and its operating system saves the ymm state:
# cpuid leaf 7 EBX bit 5, leaf 1 ECX bit 27 (OSXSAVE), then XCR0 bits 1-2
pub fun detect_avx2() bool {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        var leaf7: u64  = 0;
        var leaf1: u64  = 0;
        var xcr0:  u64  = 0;
        val p7:    *u64 = ?leaf7;
        val p1:    *u64 = ?leaf1;
        val px:    *u64 = ?xcr0;
        asm x86_64 {
            mov r8, {p7}
            mov r9, {p1}
            push rbx
            mov eax, 7
            xor ecx, ecx
            cpuid
            mov [r8], rbx
            mov eax, 1
            xor ecx, ecx
            cpuid
            mov [r9], rcx
            pop rbx
        }
        if (((leaf1 >> 27) & 1) == 0) { ret false; }
        asm x86_64 {
            mov r8, {px}
            xor ecx, ecx
            # xgetbv
            .byte 0x0F, 0x01, 0xD0 :: writes(rax, rdx)
            mov [r8], rax
        }
        ret ((leaf7 >> 5) & 1) == 1 && (xcr0 & 6) == 6;
    }
    $or {
        ret false;
    }
}

