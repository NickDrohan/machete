# add one weight column: into += row, 768 lanes
pub fun add_column_avx2(into: *i16, row: *i16) {
    $if ($mach.build.arch == $mach.arch.x86_64) {
        asm x86_64 {
            mov rdx, {into}
            mov rcx, {row}
            .byte 0xC5, 0xFE, 0x6F, 0x82, 0x00, 0x00, 0x00, 0x00 :: writes(xmm0)
            .byte 0xC5, 0xFD, 0xFD, 0x81, 0x00, 0x00, 0x00, 0x00 :: writes(xmm0)
