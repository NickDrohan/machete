            vmovdqu [rdx + 224], ymm3
            vmovdqu ymm0, [rcx + 256]
            vmovdqu [rdx + 256], ymm0
            vmovdqu ymm1, [rcx + 288]
            vmovdqu [rdx + 288], ymm1
