        val p1:    *u64 = ?leaf1;
        val px:    *u64 = ?xcr0;
        asm x86_64 {
            mov r8, {p7}
            mov r9, {p1}
            push rbx
            mov eax, 7
            xor ecx, ecx
            cpuid
            mov [r8], rbx
            mov eax, 1
            xor ecx, ecx
            cpuid
            mov [r9], rcx
            pop rbx
        }
        if (((leaf1 >> 27) & 1) == 0) { ret false; }
