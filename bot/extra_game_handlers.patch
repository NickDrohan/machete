+"""Functions for the user to implement when the config file is not adequate to express bot requirements."""
+from lib import model
+from lib.lichess_types import OPTIONS_TYPE
+
+# The lag a move costs on lichess beyond the engine's own search, about 130 ms (2026-10-21, the last moves of a
+# 5+0 game); machete keeps this much in reserve for every move still to come (MoveOverhead, since 0.5.1).
+MOVE_OVERHEAD_MS = 150
+
+
+def game_specific_options(game: model.Game) -> OPTIONS_TYPE:
+    """
+    Return a dictionary of engine options based on game aspects.
+
+    machete's Contempt applies only against an opponent rated at or below it, which it learns from
+    UCI_RatingAdv (its rating minus the opponent's). python-chess never sends that option to a UCI engine
+    (it sends UCI_Opponent, which machete does not read), so until 0.5.1 the engine always saw 0 and
+    contempt was on against stronger opponents too. The gap is sent here, per game.
+    """
+    options: OPTIONS_TYPE = {"MoveOverhead": MOVE_OVERHEAD_MS}
+    mine, theirs = game.me.rating, game.opponent.rating
+    if mine is not None and theirs is not None:
+        options["UCI_RatingAdv"] = int(mine) - int(theirs)
+    return options
+
+
+def is_supported_extra(challenge: model.Challenge) -> bool:  # noqa: ARG001
+    """
+    Determine whether to accept a challenge.
+
+    By default, True is always returned so that there are no extra restrictions beyond those in the config file.
+    """
+    return True
