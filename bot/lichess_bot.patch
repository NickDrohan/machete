+def reconnect_game_stream(li: lichess.Lichess,
+                          game: model.Game) -> tuple[Response, Iterator[bytes], GameEventType] | None:
+    """
+    Open a new stream for a game whose old stream ended before the game did.
+
+    Returns the stream, its lines with the first already read, and that first line: the game in full as lichess has
+    it now. A request that fails, or a stream that ends before saying anything, leaves the game's state unknown, so it
+    is tried again, a little later each time, until the clock of the side to move (plus a minute) has run out, after
+    which the game is certainly over. None then, or when the bot is told to quit at once.
+    """
+    wait = 0.5
+    while not stop.force_quit:
+        response: Response | None = None
+        try:
+            response = li.get_game_stream(game.id)
+            lines = response.iter_lines()
+            for line in lines:
+                if not line:
+                    continue
+                full_state = cast(GameEventType, json.loads(line.decode("utf-8")))
+                if full_state.get("type") != "gameFull":
+                    break
+                state = full_state["state"]
+                logger.info(f"Reconnected to {game.url()}: {len(state['moves'].split())} moves played, "
+                            f"status {state.get('status')}")
+                return response, lines, full_state
+            logger.info(f"The new stream for {game.url()} ended without the game's state; trying again")
+        except (HTTPError, ReadTimeout, RemoteDisconnected, ChunkedEncodingError, RequestsConnectionError,
+                ValueError) as e:
+            logger.info(f"Could not reconnect to {game.url()} ({type(e).__name__}); trying again")
+        if response is not None:
+            response.close()
+        if game.should_terminate_now():
+            logger.info(f"Leaving {game.url()}: no stream reopened before its clock ran out")
+            return None
+        time.sleep(wait)
+        wait = min(wait * 2, 5.0)
+    return None
+
